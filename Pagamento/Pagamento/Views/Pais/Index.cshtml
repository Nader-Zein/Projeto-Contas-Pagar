@{
    ViewData["Title"] = "Países";
}

@model List<Pagamento.Models.Pais>

<div class="text-center">
    <h1 class="display-4">Países</h1>

  

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <div class="d-flex justify-content-start mb-3">
        <a asp-controller="Pais" asp-action="Criar" class="btn btn-primary">Criar</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdPais</td>
                        <td>@item.NomePais</td>
                        <td>
                            @if (item.Status)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Desativado</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Pais" asp-action="Editar" asp-route-id="@item.IdPais" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-controller="Pais" asp-action="Excluir" asp-route-id="@item.IdPais" class="btn btn-danger btn-sm">Excluir</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">Nenhum país encontrado.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" id="modalErro" tabindex="-1" aria-labelledby="modalErroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalErroLabel">Atenção!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="mensagemErroModal"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {

            const mensagemErro = '@Html.Raw(TempData["ErrorMessage"])';

            if (mensagemErro) {
                // 👇 A MUDANÇA ESTÁ AQUI 👇
                document.getElementById('mensagemErroModal').innerHTML = mensagemErro;

                const modalErroElement = document.getElementById('modalErro');
                const modal = new bootstrap.Modal(modalErroElement);
                modal.show();
            }
        });
    </script>
}