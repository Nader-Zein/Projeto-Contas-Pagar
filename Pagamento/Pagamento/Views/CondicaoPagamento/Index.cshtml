@{
    ViewData["Title"] = "Condições de Pagamento";
}

@model List<Pagamento.Models.CondicaoPagamento>

<div class="text-center">
    <h1 class="display-4">Condições de Pagamento</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="d-flex justify-content-start mb-3">
        <a asp-controller="CondicaoPagamento" asp-action="Criar" class="btn btn-primary">Criar</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Juro</th>
                <th>Multa</th>
                <th>Desconto</th>
                <th>Quantidade Parcelas</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCondPgto</td>
                    <td>@item.Descricao</td>
                    <td>@item.Juros</td>
                    <td>@item.Multa</td>
                    <td>@item.Desconto</td>
                    <td>@item.QuantidadeParcelas</td>
                    <td>
                        @if (item.Status)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Desativado</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-warning btn-sm" asp-action="Editar" asp-route-id="@item.IdCondPgto">Editar</a>
                        <a class="btn btn-danger btn-sm" asp-action="Excluir" asp-route-id="@item.IdCondPgto">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" id="modalErro" tabindex="-1" aria-labelledby="modalErroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalErroLabel">Atenção!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="mensagemErroModal"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {

            const mensagemErro = '@Html.Raw(TempData["ErrorMessage"])';

            if (mensagemErro) {
                // 👇 A MUDANÇA ESTÁ AQUI 👇
                document.getElementById('mensagemErroModal').innerHTML = mensagemErro;

                const modalErroElement = document.getElementById('modalErro');
                const modal = new bootstrap.Modal(modalErroElement);
                modal.show();
            }
        });
    </script>
}