@model IEnumerable<Pagamento.Models.Produto>
@{
    ViewData["Title"] = "Produtos";
}

<h2>@ViewData["Title"]</h2>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

<div class="mb-3 text-end">
    <a asp-action="Criar" class="btn btn-success">+ Novo Produto</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th style="width: 200px;">Descrição</th>
            <th>Código de Barras</th>
            <th>Referência</th>
            <th>Marca</th>
            <th>Unidade</th>
            <th>Valor Venda</th>
            <th>Qtd</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td >@produto.IdProduto</td>
                <td style="width: 200px;">@produto.Descricao</td>
                <td>@produto.Codigo_Barras</td>
                <td>@produto.Referencia</td>
                <td>@produto.NomeMarca</td>
                <td>@produto.NomeUnidade</td>
                <td>@produto.ValorVenda.ToString("C2")</td>
                <td>@produto.Quantidade</td>
                <td>
                    @if (produto.Status)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Desativado</span>
                    }
                </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@produto.IdProduto" class="btn btn-sm btn-primary">Editar</a>
                    <a asp-action="Excluir" asp-route-id="@produto.IdProduto" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="modal fade" id="modalErro" tabindex="-1" aria-labelledby="modalErroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalErroLabel">Atenção!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="mensagemErroModal"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {

            const mensagemErro = '@Html.Raw(TempData["ErrorMessage"])';

            if (mensagemErro) {
                // 👇 A MUDANÇA ESTÁ AQUI 👇
                document.getElementById('mensagemErroModal').innerHTML = mensagemErro;

                const modalErroElement = document.getElementById('modalErro');
                const modal = new bootstrap.Modal(modalErroElement);
                modal.show();
            }
        });
    </script>
}