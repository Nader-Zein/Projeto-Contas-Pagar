<div class="modal fade" id="modalMarca" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalMarcaContent"></div>
    </div>
</div>

<div class="modal fade" id="modalUnidade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalUnidadeContent"></div>
    </div>
</div>

<div class="modal fade" id="modalCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalCategoriaContent"></div>
    </div>
</div>

<div class="modal fade" id="modalFornecedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalFornecedorContent">
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaCidadeFornecedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalNovaCidadeContentFornecedor">
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaCondicaoFornecedor" tabindex="-1" aria-labelledby="modalNovaCondicaoFornecedorLabel">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovaCondicaoContentFornecedor">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNovaCondicaoFornecedorLabel">Cadastrar Condição</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <!-- conteúdo via AJAX -->
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>



            document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.chk-fornecedor').forEach(function (chk) {
                chk.addEventListener('change', atualizarListaFornecedores);
            });

            atualizarListaFornecedores();
            });



        // guarda o último modal pai que foi fechado
        let ultimoModalPaiFechado = null;

        function fecharModalPaiAtual() {
          const pai = document.querySelector('#modalFornecedor.show, #modalNovoFornecedor.show, #modalFornecedorProduto.show');
          if (pai) {
            ultimoModalPaiFechado = pai.id;
            bootstrap.Modal.getInstance(pai)?.hide();
          } else {
            ultimoModalPaiFechado = null;
          }
        }

        function reabrirModalPai() {
          if (!ultimoModalPaiFechado) return;
          const el = document.getElementById(ultimoModalPaiFechado);
          bootstrap.Modal.getOrCreateInstance(el).show();
          ultimoModalPaiFechado = null;
        }

        // wrappers para abrir os seletores (filhos)
        // function abrirSelecaoCidadeDesdeFornecedor() {
        //   fecharModalPaiAtual();
        //   bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCidadeFornecedor')).show();
        // }



        function abrirSelecaoCidadeDesdeFornecedor() {
          const filho = document.getElementById('modalCidadeFornecedor');
          const pai = document.querySelector('#modalFornecedor.show, #modalNovoFornecedor.show, #modalFornecedorProduto.show');
          if (pai) {
            // guarda o id do pai no próprio modal filho (evita variável global ficar “velha”)
            filho.dataset.parentModalId = pai.id;
            bootstrap.Modal.getInstance(pai)?.hide();
          } else {
            filho.dataset.parentModalId = '';
          }
          bootstrap.Modal.getOrCreateInstance(filho).show();
        }
        // function abrirSelecaoCondicaoDesdeFornecedor() {
        //   fecharModalPaiAtual();
        //   bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCondicaoPgtoFornecedor')).show();
        // }


        function abrirSelecaoCondicaoDesdeFornecedor() {
          const filho = document.getElementById('modalCondicaoPgtoFornecedor');
          const pai = document.querySelector('#modalFornecedor.show, #modalNovoFornecedor.show, #modalFornecedorProduto.show');
          if (pai) {
            filho.dataset.parentModalId = pai.id;
            bootstrap.Modal.getInstance(pai)?.hide();
          } else {
            filho.dataset.parentModalId = '';
          }
          bootstrap.Modal.getOrCreateInstance(filho).show();
        }

                // 2) Se o usuário fechar o modal filho SEM escolher nada, reabrimos o pai salvo
        ['modalCidadeFornecedor', 'modalCondicaoPgtoFornecedor'].forEach(id => {
          const el = document.getElementById(id);
          if (!el) return;
          el.addEventListener('hidden.bs.modal', function () {
            const parentId = el.dataset.parentModalId;
            if (!parentId) return; // nada para reabrir
            const pai = document.getElementById(parentId);
            if (pai) bootstrap.Modal.getOrCreateInstance(pai).show();
            el.dataset.parentModalId = ''; // limpa para não “vazar” para a próxima abertura
          });
        });


        // intercepta cliques em botões/links que abririam os modais filhos via data-bs-*
        document.addEventListener('click', function(e){
          const t = e.target.closest('[data-bs-target="#modalCidadeFornecedor"]');
          if (t) { e.preventDefault(); abrirSelecaoCidadeDesdeFornecedor(); }
        }, true);

        document.addEventListener('click', function(e){
          const t = e.target.closest('[data-bs-target="#modalCondicaoPgtoFornecedor"]');
          if (t) { e.preventDefault(); abrirSelecaoCondicaoDesdeFornecedor(); }
        }, true);

        //====================================================================================
            function selecionarMarca(id, nome) {
            $('#MarcaId').val(id);
            $('#NomeMarcaSelecionada').val(nome);
            bootstrap.Modal.getInstance(document.getElementById('modalMarcaSelecionar')).hide();
            }

            function selecionarUnidade(id, nome) {
            $('#UnidadeMedidaId').val(id);
            $('#NomeUnidadeSelecionada').val(nome);
            bootstrap.Modal.getInstance(document.getElementById('modalUnidadeSelecionar')).hide();
            }

            function selecionarCategoria(id, nome) {
            $('#CategoriaId').val(id);
            $('#NomeCategoriaSelecionada').val(nome);
            bootstrap.Modal.getInstance(document.getElementById('modalCategoriaSelecionar')).hide();
            }



            $(document).on('change', '.chk-fornecedor', function () {
            const fornecedoresSelecionados = [];
            const nomesSelecionados = [];

            $('.chk-fornecedor:checked').each(function () {
                fornecedoresSelecionados.push($(this).val());
                nomesSelecionados.push($(this).data('nome'));
            });

            $('#fornecedoresSelecionados').val(fornecedoresSelecionados.join(','));
            $('#NomeFornecedorSelecionado').val(nomesSelecionados.join(', '));
        });

            function atualizarListaFornecedores() {
            const selecionados = [];
            const nomes = [];

            document.querySelectorAll('.chk-fornecedor:checked').forEach(chk => {
                selecionados.push(chk.value);
                nomes.push(chk.dataset.nome);
            });

            document.getElementById('fornecedoresSelecionados').value = selecionados.join(',');

            document.getElementById('NomeFornecedorSelecionado').value = nomes.join(', ');
            }

            function filtrarTabelaMarca() {
            const filtro = $('#filtroMarca').val().toLowerCase();
            $('#tabelaMarcas tbody tr').each(function () {
                const nome = $(this).find('td:first').text().toLowerCase();
                $(this).toggle(nome.includes(filtro));
            });
            }

            function filtrarTabelaFornecedor() {
            const filtro = $('#filtroFornecedor').val().toLowerCase();
            $('#tabelaFornecedores tbody tr').each(function () {
                const nome = $(this).find('td:nth-child(2)').text().toLowerCase();
                $(this).toggle(nome.includes(filtro));
            });
            }


            function filtrarTabelaUnidade() {
            const filtro = $('#filtroUnidade').val().toLowerCase();
            $('#tabelaUnidades tbody tr').each(function () {
                const nome = $(this).find('td:first').text().toLowerCase();
                $(this).toggle(nome.includes(filtro));
            });
            }

            function filtrarTabelaCategoria() {
            const filtro = $('#filtroCategoria').val().toLowerCase();
            $('#tabelaCategorias tbody tr').each(function () {
                const nome = $(this).find('td:first').text().toLowerCase();
                $(this).toggle(nome.includes(filtro));
            });
            }

            function abrirFormMarca() {
            $.get('/Marca/FormModal', function (data) {
                $('#modalMarcaContent').html(data);
                new bootstrap.Modal(document.getElementById('modalMarca')).show();
            });
            }

            function abrirFormUnidade() {
            $.get('/UnidadeMedida/FormModal', function (data) {
                $('#modalUnidadeContent').html(data);
                new bootstrap.Modal(document.getElementById('modalUnidade')).show();
            });
            }

            function abrirFormCategoria() {
            $.get('/Categoria/FormModal', function (data) {
                $('#modalCategoriaContent').html(data);
                new bootstrap.Modal(document.getElementById('modalCategoria')).show();
            });
            }

            function abrirFormFornecedor() {
            $.get('/Fornecedor/FormModal', function (data) {
                $('#modalFornecedorContent').html(data);
                new bootstrap.Modal(document.getElementById('modalFornecedor')).show();
            });
