                                        Selecionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr />
                <button class="btn btn-success" type="button" onclick="abrirFormNovaCidadeFornecedor()">+ Cadastrar nova Cidade</button>
                <div id="formNovaCidadeContainer"></div>
            </div>
        </div>
    </div>
</div>

