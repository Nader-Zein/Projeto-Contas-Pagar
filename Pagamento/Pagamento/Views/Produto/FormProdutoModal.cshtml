@model Pagamento.Models.Produto

<div class="modal-header">
    <h5 class="modal-title">Cadastrar Produto</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
</div>

<div class="modal-body">
    <form id="formCadastrarProduto" method="post" action="/Produto/FormModal">
        <div class="row">

            <div class="d-flex justify-content-end mt-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="Status" />
                    <label class="form-check-label" asp-for="Status">Ativo</label>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Descricao" class="form-label">Descrição</label>
                <input asp-for="Descricao" class="form-control" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Codigo_Barras" class="form-label">Código de Barras</label>
                <input asp-for="Codigo_Barras" class="form-control" />
                <span asp-validation-for="Codigo_Barras" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Referencia" class="form-label">Referência</label>
                <input asp-for="Referencia" class="form-control" />
                <span asp-validation-for="Referencia" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Marca</label>
                <div class="input-group">
                    <input type="text" id="NomeMarcaSelecionada" class="form-control" placeholder="Nenhuma marca selecionada" readonly />
                    <input type="hidden" asp-for="MarcaId" id="MarcaId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalMarcaSelecionar">
                        Selecionar
                    </button>
                </div>
                <span asp-validation-for="MarcaId" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Unidade de Medida</label>
                <div class="input-group">
                    <input type="text" id="NomeUnidadeSelecionada" class="form-control" placeholder="Nenhuma unidade selecionada" readonly />
                    <input type="hidden" asp-for="UnidadeMedidaId" id="UnidadeMedidaId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalUnidadeSelecionar">
                        Selecionar
                    </button>
                </div>
                <span asp-validation-for="UnidadeMedidaId" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Fornecedores</label>
                <div class="input-group">
                    <input type="text" id="NomeFornecedorSelecionado" class="form-control" placeholder="Nenhum fornecedor selecionado" readonly />
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalFornecedorSelecionarProduto">
                        Selecionar
                    </button>
                </div>
                @if (ViewData.ModelState["FornecedoresSelecionados"]?.Errors.Count > 0)
                {
                    <span class="text-danger">@ViewData.ModelState["FornecedoresSelecionados"].Errors[0].ErrorMessage</span>
                }
            </div>
            <input type="hidden" id="fornecedoresSelecionados" name="FornecedoresSelecionados" />

            <div class="col-md-4 mb-3">
                <label class="form-label">Categoria</label>
                <div class="input-group">
                    <input type="text" id="NomeCategoriaSelecionada" class="form-control" placeholder="Nenhuma categoria selecionada" readonly />
                    <input type="hidden" asp-for="CategoriaId" id="CategoriaId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalCategoriaSelecionar">
                        Selecionar
                    </button>
                </div>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="CustoMedio" class="form-label">Custo Medio</label>
                <input asp-for="CustoMedio" class="form-control" type="text" readonly />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="PercentualLucro" class="form-label">% Lucro</label>
                <input asp-for="PercentualLucro" class="form-control" type="text"  readonly/>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="ValorVenda" class="form-label">Valor de Venda</label>
                <input asp-for="ValorVenda" class="form-control" type="text" oninput="this.value = this.value.replace(/[^0-9.,]/g, '')" />
                <span asp-validation-for="ValorVenda" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="CustoUltimaCompra" class="form-label">Custo Ultima Compra</label>
                <input asp-for="CustoUltimaCompra" class="form-control" type="text" readonly/>
                
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Quantidade" class="form-label">Quantidade</label>
                <input asp-for="Quantidade" class="form-control" disabled />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="QuantidadeMinima" class="form-label">Quantidade Mínima</label>
                <input asp-for="QuantidadeMinima" class="form-control" />
                <span asp-validation-for="QuantidadeMinima" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Observacoes" class="form-label">Observações</label>
                <textarea asp-for="Observacoes" class="form-control"></textarea>
            </div>

            <!-- Campos de data somente informativos no modal -->
            <div class="col-md-4 mb-3">
                <label class="form-label">Data de Criação</label>
                <input type="text" class="form-control" value="@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")" readonly />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Última Edição</label>
                <input type="text" class="form-control" value="@(Model.DataEdicao?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca editado")" readonly />
            </div>

        </div>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success">Salvar</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        </div>
    </form>

   
</div>

<script>
    // =================================================================================
    // SCRIPTS ESPECÍFICOS PARA O MODAL DE CADASTRO DE PRODUTO
    // =================================================================================

    // ALTERAÇÃO 5: A função para abrir o form de fornecedor agora tem um nome único
    function abrirFormNovoFornecedorProduto() {
        // Opcional: Esconde o modal de seleção para evitar problemas de sobreposição
        var selectionModal = bootstrap.Modal.getInstance(document.getElementById('modalFornecedorSelecionarProduto'));
        if (selectionModal) {
            selectionModal.hide();
        }

        $.get('@Url.Action("FormModal", "Fornecedor")', function (data) {
            // Alvo nos novos IDs únicos
            $('#modalFornecedorProdutoContent').html(data);
            var modal = new bootstrap.Modal(document.getElementById('modalFornecedorProduto'));
            modal.show();
        });
    }


        

    

</script>