@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>


        function verificarParcelasAntesDeSalvar() {
            var formJQuery = $('#form-venda');
            var formNativo = document.getElementById('form-venda');

            if (!formJQuery.valid()) {
                return;
            }

            var qtdParcelas = document.getElementById('tabela-parcelas').children.length;

            if (qtdParcelas === 0) {
                var modalAviso = new bootstrap.Modal(document.getElementById('modalAvisoParcelas'));
                modalAviso.show();
            } else {
                if (modo === "Criar") {
                    formNativo.querySelectorAll('fieldset:disabled').forEach(fs => fs.disabled = false);
                    formNativo.querySelectorAll('[disabled]').forEach(el => el.disabled = false);
                }

                const itens = [];
                document.querySelectorAll('#tabela-produtos tr').forEach(tr => {
                    itens.push({
                        ProdutoId: parseInt(tr.dataset.id),
                        Quantidade: parseFloat(tr.dataset.qtd),
                        ValorUnitario: parseFloat(tr.dataset.valor)
                    });
                });

                if (itens.length === 0) {
                    alert('É necessário adicionar pelo menos um produto à venda.');
                    return;           
                }

                const hidden = document.getElementById('itens-json');
                if (hidden) hidden.value = JSON.stringify(itens);

                formNativo.submit();
            }
        }

        async function buscarEselecionarCondicaoPorId() {
            const idInput = document.getElementById('condicao-id-input');
            const id = parseInt(idInput.value);

            if (!id || id <= 0) {
                alert('Por favor, digite um ID de condição válido.');
                return;
            }

            try {
                const response = await fetch(`@Url.Action("BuscarPorIdJSON", "CondicaoPagamento")?id=${id}`);

                if (!response.ok) {
                    const errorData = await response.json().catch(() => null);
                    alert(errorData?.mensagem || 'Condição de pagamento não encontrada.');
                    return;
                }

                const condicao = await response.json();

                const idCond =
                    condicao.idCondPgto ??
                    condicao.id ??
                    condicao.idCondicao ??
                    id;

                const descricao =
                    condicao.descricao ??
                    condicao.nome ??
                    condicao.Descricao ??
                    "";

                selecionarCondicaoVenda(idCond, descricao);

                idInput.value = '';

            } catch (error) {
                console.error('Erro ao buscar condição por ID:', error);
                alert('Ocorreu um erro de comunicação ao tentar buscar a condição.');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const btnBuscarCondicaoId = document.getElementById('btn-buscar-condicao-por-id');
            if (btnBuscarCondicaoId) {
                btnBuscarCondicaoId.addEventListener('click', buscarEselecionarCondicaoPorId);
            }
        });
        
        

        let parcelasTemp = [];                 

                
        function abrirFormNovaCondicaoVenda() {
            parcelasTemp = [];
            $.get('@Url.Action("FormModal", "CondicaoPagamento")', function (html) {
                $('#modalNovaCondicaoContent').html(html);

                $('#modalNovaCondicaoContent')
                  .find('[data-bs-target="#modalFormaPgto"]')
                  .attr('data-bs-target', '#modalFormaPgtoSelect');

                new bootstrap.Modal(document.getElementById('modalNovaCondicao')).show();

                setupModalFormaPgtoSelectWiring();
            });
        }

        $(document).on('submit', '#formCadastrarCondicaoPgto', function (e) {
            e.preventDefault();

            let total = parcelasTemp.reduce((sum, p) => sum + (parseFloat(p.valorPercentual) || 0), 0);
            if (Math.abs(total - 100) > 0.1) {
                alert(`A soma das parcelas deve ser 100%. Atual: ${total.toFixed(2)}%`);
                return;
            }

            let formData = $(this).serializeArray();
            formData.push({ name: "ParcelasJson", value: JSON.stringify(parcelasTemp) });

            $.ajax({
                type: 'POST',
                url: '@Url.Action("FormModal", "CondicaoPagamento")',
                data: $.param(formData),
                success: function (res) {
                    if (res.sucesso) {
                        var modalEl = document.getElementById('modalNovaCondicao');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();

                        modalEl.addEventListener('hidden.bs.modal', function () {
                            $('.modal-backdrop').remove();
                            $('body').removeClass('modal-open').css('overflow', '');

                            var modalSelEl = document.getElementById('modalCondicaoVenda');
                            if(modalSelEl) new bootstrap.Modal(modalSelEl).show();

                        }, { once: true });

                        const novaLinha = `
                            <tr class="table-success">
                                <td>${res.condicao.id}</td>
                                <td>${res.condicao.nome}</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary"
                                        onclick="selecionarCondicaoVenda(${res.condicao.id}, '${res.condicao.nome}')">
                                        Selecionar
                                    </button>
                                </td>
                            </tr>`;

                        $('#tabelaCondicoesModal tbody').append(novaLinha);         

                    } else {
                        $('#modalNovaCondicaoContent').html(res);
                        renderizarTabelaParcelas();
                        setupModalFormaPgtoSelectWiring();         
                    }
                },
                error: function() { alert("Erro ao salvar condição."); }
            });
        });

                
        document.getElementById('modalNovaCondicao')
          .addEventListener('hidden.bs.modal', function () {

              if (nestingFormaAberto) return;             

              document.getElementById('modalNovaCondicaoContent').innerHTML = '';
              parcelasTemp = [];
        });

        $(document).on('click', '#btnAdicionarParcela', function () {
            const num = parseInt($('#NumeroParcela').val());
            const idForma = parseInt($('#IdFormaPgto').val());
            const nomeForma = $('#NomeFormaSelecionada').val();
            const valor = parseFloat($('#ValorPercentual').val());
            const dias = parseInt($('#DiasAposVenda').val());

            if (!num || !idForma || isNaN(valor) || isNaN(dias)) {
                alert("Preencha todos os campos da parcela.");
                return;
            }

            if (parcelasTemp.some(p => p.numeroParcela === num)) {
                alert("Número de parcela já existe.");
                return;
            }

            let total = parcelasTemp.reduce((sum, p) => sum + p.valorPercentual, 0);
            if (total + valor > 100) {
                alert(`Ultrapassa 100%. Disponível: ${(100 - total).toFixed(2)}%`);
                return;
            }

            parcelasTemp.push({
                numeroParcela: num,
                idFormaPgto: idForma,
                descricaoFormaPgto: nomeForma,
                valorPercentual: valor,
                diasAposVenda: dias
            });

            renderizarTabelaParcelas();

            $('#NumeroParcela').val(parcelasTemp.length + 1);       
            $('#ValorPercentual').val('');
            $('#DiasAposVenda').val('');
        });

        $(document).on('click', '.removerParcelaTemp', function () {
            const num = $(this).data('num');
            parcelasTemp = parcelasTemp.filter(p => p.numeroParcela !== num);
            renderizarTabelaParcelas();
        });

        function renderizarTabelaParcelas() {
            const tbody = $('#tabelaParcelas tbody');
            tbody.empty();

            parcelasTemp.sort((a, b) => a.numeroParcela - b.numeroParcela);

            parcelasTemp.forEach(p => {
                const tr = `
                    <tr>
                        <td>${p.numeroParcela}</td>
                        <td>${p.descricaoFormaPgto}</td>
                        <td>${p.valorPercentual}%</td>
                        <td>${p.diasAposVenda}</td>
                        <td><button type="button" class="btn btn-sm btn-danger removerParcelaTemp" data-num="${p.numeroParcela}">Excluir</button></td>
                    </tr>`;
                tbody.append(tr);
            });
        }

        let nestingFormaAberto = false;
                
        function setupModalFormaPgtoSelectWiring() {
            const container = document.getElementById('modalNovaCondicaoContent');
            if (!container) return;

            const auxEl = document.getElementById('modalFormaPgtoSelect');
            const mainEl = document.getElementById('modalNovaCondicao');
            if (!auxEl || !mainEl) return;

            if (auxEl.dataset.nestingInit === '1') return;
            auxEl.dataset.nestingInit = '1';

            auxEl.addEventListener('show.bs.modal', () => {
                nestingFormaAberto = true;
                bootstrap.Modal.getInstance(mainEl)?.hide();
            });

            auxEl.addEventListener('hidden.bs.modal', () => {
                nestingFormaAberto = false;

                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');

                bootstrap.Modal.getOrCreateInstance(mainEl).show();
            });
        }

        window.abrirFormNovaFormaPgto = function () {

            const auxEl = document.getElementById('modalFormaPgtoSelect');
            const auxInst = bootstrap.Modal.getInstance(auxEl);

            if (auxInst) auxInst.hide();

            $.get('@Url.Action("FormModal", "FormaPagamento")', function (html) {

                $('#modalNovaFormaContent').html(html);

                const novaEl = document.getElementById('modalNovaForma');
                const novaInst = bootstrap.Modal.getOrCreateInstance(novaEl);
                novaInst.show();

                novaEl.addEventListener('hidden.bs.modal', function () {

                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('overflow');
                    document.body.style.removeProperty('padding-right');

                    bootstrap.Modal.getOrCreateInstance(auxEl).show();

                }, { once: true });
            });
        };

        $(document).on('click', '.btn-select-forma', function () {
            const id = parseInt(this.dataset.id);
            const nome = this.dataset.nome;
            confirmarFormaParaCondicao(id, nome);
        });

        function confirmarFormaParaCondicao(id, nome) {
            $('#IdFormaPgto').val(id);
            $('#NomeFormaSelecionada').val(nome);

            const auxEl = document.getElementById('modalFormaPgtoSelect');
            const auxInst = bootstrap.Modal.getInstance(auxEl);
            if (auxInst) auxInst.hide();               
        }

        function fecharModalForma_VoltarCondicao() {
            const auxEl = document.getElementById('modalFormaPgtoSelect');
            const auxInst = bootstrap.Modal.getInstance(auxEl);
            if (auxInst) auxInst.hide();
        }



                
        function getModalNovoProdutoInst() {
            const el = document.getElementById('modalNovoProduto');
            return bootstrap.Modal.getOrCreateInstance(el);
        }



        function abrirFormNovoProduto() {
            $.get('@Url.Action("FormModal", "Produto")', function (html) {
                $('#modalNovoProdutoContent').html(html);

                const el = document.getElementById('modalNovoProduto');
                const inst = bootstrap.Modal.getOrCreateInstance(el);
                inst.show();
            });
        }

        $(document).on('submit', '#formCadastrarProduto', function (e) {                       
            e.preventDefault();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("FormModal", "Produto")',
                data: $(this).serialize(),
                success: function (res) {
                    if (res.sucesso) {
                        var modalEl = document.getElementById('modalNovoProduto');
                        var modalInst = bootstrap.Modal.getInstance(modalEl);
                        modalInst.hide();

                        modalEl.addEventListener('hidden.bs.modal', function () {
                            $('.modal-backdrop').remove();
                            $('body').removeClass('modal-open').css('overflow', '');

                            var modalSelEl = document.getElementById('modalProduto');
                            if(modalSelEl) {
                                var modalSel = new bootstrap.Modal(modalSelEl);
                                modalSel.show();
                            }

                        }, { once: true });

                                
                            const id = res.produto.id;
                            const nome = res.produto.nome || '';
