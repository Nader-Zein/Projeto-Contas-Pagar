            document.getElementById('btn-adicionar-produto').addEventListener('click', function() {
                const id = document.getElementById('IdProdutoSelecionado').value;
                const nome = document.getElementById('NomeProdutoSelecionado').value;
                const un = document.getElementById('UnidadeProdutoSelecionado').value;
                const qtd = parseFloat(document.getElementById('produto-quantidade').value);
                const valorStr = document.getElementById('produto-valor').value;
                const valor = parseMoeda(valorStr);

                const estoqueDisponivel = parseFloat(document.getElementById('EstoqueProdutoSelecionado').value) || 0;
            
                if(!id || !qtd || !valor) { alert("Preencha o produto corretamente."); return; }

                const total = qtd * valor;
                const tbody = document.getElementById('tabela-produtos');

                if([...tbody.querySelectorAll('tr')].some(tr => tr.dataset.id === id)) {
                    alert("Produto já adicionado."); return;
                }

                if (qtd > estoqueDisponivel) {
                    alert(`Estoque insuficiente! Você tentou adicionar ${qtd}, mas só existem ${estoqueDisponivel} unidades disponíveis.`);
                    return;               
                }
                const tr = document.createElement('tr');
                tr.dataset.id = id;
                tr.dataset.qtd = qtd;
                tr.dataset.valor = valor;

                tr.innerHTML = `
                    <td>${id}</td>
                    <td>${nome}</td>
                    <td>${un}</td>
                    <td>${qtd}</td>
                    <td>${formatarMoeda(valor)}</td>
                    <td>${formatarMoeda(total)}</td>
                    <td><button type="button" class="btn btn-sm btn-danger btn-remover">Remover</button></td>
                `;
                tbody.appendChild(tr);

                limparInputsProduto();

                document.getElementById('fieldset-financeiro').disabled = false;
                atualizarTotais();
            });

