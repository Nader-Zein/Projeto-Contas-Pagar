        async function verificarChaveDuplicada() {
            const modeloInput = document.getElementById('Modelo');
            const serieInput = document.getElementById('Serie');
            const numeroNotaInput = document.getElementById('NumeroNota');
            const clienteIdInput = document.getElementById('ClienteId');       

            const modelo = modeloInput?.value?.trim() || '';
            const serie = serieInput?.value?.trim() || '';
            const numeroNota = numeroNotaInput?.value?.trim() || '';
            const clienteId = parseInt(clienteIdInput?.value || '0');

            if (modelo && serie && numeroNota && clienteId > 0) {
                console.log('Verificando chave Venda:', modelo, serie, numeroNota, clienteId);

                try {
                    const url = `@Url.Action("VerificarDuplicidade", "Venda")?modelo=${encodeURIComponent(modelo)}&serie=${encodeURIComponent(serie)}&numeroNota=${encodeURIComponent(numeroNota)}&clienteId=${clienteId}`;

                    const response = await fetch(url);
                    if (!response.ok) throw new Error("Erro na requisição");

                    const resultado = await response.json();

                    if (resultado.existe) {
                        const venda = resultado.venda;

                        document.getElementById('venda-existente-modelo').textContent = venda.modelo || '-';
                        document.getElementById('venda-existente-serie').textContent = venda.serie || '-';
                        document.getElementById('venda-existente-numero').textContent = venda.numeroNota || '-';
                        document.getElementById('venda-existente-cliente').textContent = `${venda.clienteId} - ${venda.nomeCliente || 'N/A'}`;
                        document.getElementById('venda-existente-emissao').textContent = formatarDataString(venda.dataEmissao);
                        document.getElementById('venda-existente-funcionario').textContent = venda.funcionario || '-';
                        document.getElementById('venda-existente-total').textContent = venda.total || '-';
                        document.getElementById('venda-existente-obs').textContent = venda.observacoes || '(Nenhuma)';

                        const modalEl = document.getElementById('modalVendaExistente');
                        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modal.show();

                        modeloInput.value = '';
                        serieInput.value = '';
                        numeroNotaInput.value = '';

                        clienteIdInput.value = '';
                        document.getElementById('tabela-cliente-selecionado').innerHTML = '';
                        document.getElementById('cliente-id-input').value = '';
                       

                        modeloInput.focus();
                    }

                } catch (error) {
                    console.error('Erro ao verificar duplicidade:', error);
                }
            }
        }


