@model Pagamento.Models.Venda

@{
    string modo = ViewData["Modo"] as string ?? "Criar";
    ViewData["Title"] = modo == "Criar" ? "Nova Venda" : (modo == "Detalhes" ? "Detalhes da Venda" : "Cancelar Venda");
    bool isReadOnly = (modo != "Criar");
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="@(modo == "Cancelar" ? "ConfirmarCancelamento" : "Criar")" method="post" id="form-venda">
    <input type="hidden" name="itensJson" id="itens-json" />

    <input asp-for="ClienteId" type="hidden" id="ClienteId" />
    <input asp-for="FuncionarioId" type="hidden" id="FuncionarioIdInput" />
    <input asp-for="CondicaoPagamentoId" type="hidden" id="CondicaoPagamentoVendaId" />

    <fieldset @(isReadOnly ? "disabled" : "")>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Dados da Venda</span>
                <div class="form-check form-switch">
                    <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" checked>
                    <label asp-for="Status" class="form-check-label">Ativa</label>
                </div>
            </div>
            <div class="card-body">
                <fieldset id="fieldset-dados-nota">
                    <div class="row">
                        <div class="col-md-2">
                            <label asp-for="Modelo" class="form-label">Modelo*</label>
                            <input asp-for="Modelo" class="form-control" />
                            <span asp-validation-for="Modelo" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Serie" class="form-label">Serie*</label>
                            <input asp-for="Serie" class="form-control" />
                            <span asp-validation-for="Serie" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="NumeroNota" class="form-label">Número da Nota*</label>
                            <input asp-for="NumeroNota" class="form-control" />
                            <span asp-validation-for="NumeroNota" class="text-danger"></span>
                        </div>
                        <div class="@(modo == "Criar" ? "col-md-4" : "col-md-2")">
                            <label class="form-label">Cliente*</label>
                            @if (modo == "Criar")
                            {
                                <div class="input-group mb-2">
                                    <input type="number" id="cliente-id-input" class="form-control" placeholder="ID..." style="max-width: 120px;" />
                                    <button type="button" id="btn-buscar-cliente-id" class="btn btn-primary">Buscar ID</button>
                                    <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#modalCliente">Buscar Nome</button>
                                </div>
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>ID</th><th>Cliente Selecionado</th></tr></thead>
                                    <tbody id="tabela-cliente-selecionado">
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@Model.NomeCliente (ID: @Model.ClienteId)" readonly />
                            }
                        </div>

                        @if (modo == "Detalhes" || modo == "Cancelar")
                        {
                            <div class="w-100 d-none d-md-block"></div>
                        }

                        <div class="@(modo == "Criar" ? "col-md-3" : "col-md-2")">
                            <label asp-for="DataEmissao" class="form-label">Data de Emissão</label>
                            <input asp-for="DataEmissao" type="date" class="form-control" id="DataEmissao" />
                        </div>
                        <div class="@(modo == "Criar" ? "col-md-6" : "col-md-2")">
                            <label class="form-label text-nowrap">Funcionário (Vendedor)*</label>

                            @if (modo == "Criar")
                            {
                                <div class="input-group mb-2">
                                    <input type="number" id="funcionario-id-input" class="form-control" placeholder="ID..." style="max-width: 120px;" />

                                    <button type="button" id="btn-buscar-funcionario-id" class="btn btn-primary">Buscar ID</button>

                                    <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#modalSelecionarFuncionario">
                                        Buscar Nome
                                    </button>
                                </div>

                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px;">ID</th>
                                            <th>Funcionário Selecionado</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tabela-funcionario-selecionado">
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@Model.NomeFuncionario (ID: @Model.FuncionarioId)" readonly />
                            }

                           
                            <span asp-validation-for="FuncionarioId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mt-3">
                        

                       
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Lista de Produtos</div>
            <div class="card-body">
                <fieldset id="fieldset-lista-produtos" disabled>
                    @if (modo == "Criar")
                    {
                        <div class="row align-items-end gx-2">
                            <div class="col-md-auto">
                                <label class="form-label">Produto*</label>
                                <div class="input-group">
                                    <input type="number" id="produto-id-input" class="form-control" placeholder="ID..." style="max-width: 100px;" />
                                    <button type="button" id="btn-buscar-produto-por-id" class="btn btn-primary">Buscar ID</button>
                                    <button class="btn btn-outline-secondary ms-2" type="button" data-bs-toggle="modal" data-bs-target="#modalProduto" title="Abrir lista">Buscar</button>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Descrição</label>
                                <input type="text" id="NomeProdutoSelecionado" class="form-control" readonly placeholder="-" />
                                <input type="hidden" id="IdProdutoSelecionado" />
                                <input type="hidden" id="UnidadeProdutoSelecionado" />
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">UN</label>
                                <input id="produto-unidade" type="text" class="form-control" readonly />
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Qtd*</label>
                                <input id="produto-quantidade" type="number" class="form-control" value="1" min="1" />
                            </div>
                            <div style="width: 10%;">
                                <label class="form-label">Valor (R$)*</label>
                                <input id="produto-valor" type="text" class="form-control" />
                            </div>
                            <div style="width: 12.5%;">
                                <label class="form-label">Total</label>
                                <input id="produto-total" type="text" class="form-control" readonly />
                            </div>

                            <div class="col-md-auto d-flex gap-1 ms-3 align-self-end">
                                <button type="button" id="btn-adicionar-produto" class="btn btn-secondary">Adicionar</button>
                                <button type="button" id="btn-limpar-produtos" class="btn btn-outline-danger" title="Limpar lista">
                                    <i class="bi bi-trash"></i> Limpar
                                </button>
                            </div>
                        </div>
                        <input type="hidden" id="EstoqueProdutoSelecionado" />

                    }

                    <table class="table table-hover mt-3">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Produto</th>
                                <th>UN</th>
                                <th>Qtd</th>
                                <th>Vl. Unitário</th>
                                <th>Total</th>
                                @if (modo == "Criar")
                                {
                                    <th>Ação</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="tabela-produtos">
                            @if (isReadOnly)
                            {
                                foreach (var item in Model.Itens)
                                {
                                    <tr>
                                        <td>@item.ProdutoId</td>
                                        <td>@item.NomeProduto</td>
                                        <td>@item.NomeUnidade</td>
                                        <td>@item.Quantidade</td>
                                        <td>@item.ValorUnitario.ToString("C2")</td>
                                        <td>@item.Total.ToString("C2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </fieldset>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Financeiro</div>
            <div class="card-body">
                <fieldset id="fieldset-financeiro" disabled>
                    <div class="mb-4">
                        <h5>Valores Totais</h5><hr />
                        <div class="mb-2 row fw-bold fs-5">
                            <label class="col-sm-4 col-form-label">Total a Pagar</label>
                            <div class="col-sm-3">
                                <input type="text" readonly class="form-control-plaintext fs-4 " id="total-nota"
                                       value="@(isReadOnly? Model.TotalNota.ToString("C2") : "R$ 0,00")">
                            </div>
                        </div>
                    </div>

                    <div>
                        <h5>Pagamento</h5><hr />
                        <label class="form-label">Condição de Pagamento*</label>
                        <div class="row">
                            <div class="@(modo == "Criar" ? "col-md-8" : "col-md-3 col-lg-2")">
                                <div class="input-group flex-grow-1">
                                    <input type="text" id="NomeCondicaoVenda" class="form-control" readonly
                                           placeholder="@(isReadOnly ? "" : "Selecione a condição...")"
                                           value="@(isReadOnly? ViewBag.NomeCondicaoPagamento: "")" />

                                    @if (modo == "Criar")
                                    {

                                        <input type="number"
                                               id="condicao-id-input"
                                               class="form-control"
                                               placeholder="ID"
                                               style="max-width: 100px;" />

                                        <button type="button"
                                                id="btn-buscar-condicao-por-id"
                                                class="btn btn-primary">
                                            Buscar ID
                                        </button>

                                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalCondicaoVenda">Buscar</button>
                                        <button type="button" id="btn-gerar-parcelas" class="btn btn-dark ms-3">Gerar Parcelas</button>
                                        <button type="button" id="btn-limpar-parcelas" class="btn btn-outline-danger ms-1">Limpar</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-2">
                            <thead><tr><th>Parcela</th><th>Valor</th><th>Vencimento</th><th>Forma de Pagamento</th></tr></thead>
                            <tbody id="tabela-parcelas">
                                @if (isReadOnly && Model.ParcelasGeradas != null)
                                {
                                    foreach (var p in Model.ParcelasGeradas)
                                    {
                                        <tr>
                                            <td>@p.NumeroParcela</td>
                                            <td>@p.ValorParcela.ToString("C2")</td>
                                            <td>@p.DataVencimento.ToString("dd/MM/yyyy")</td>
                                            <td>@p.NomeFormaPgto</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <label asp-for="Observacoes" class="form-label">Observações Gerais</label>
                <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
            </div>
        </div>

        @if (modo == "Detalhes" && Model.Status == false)
        {
            <div class="card mt-3">
                <div class="card-header bg-danger text-white">
                    Motivo do Cancelamento
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label asp-for="Motivo_Cancelamento" class="form-label fw-bold"> Motivo</label>
                            <textarea asp-for="Motivo_Cancelamento" class="form-control" rows="3" readonly></textarea>
                        </div>
                    </div>
                </div>
            </div>
        }


    </fieldset>

    @if (modo == "Cancelar")
    {
        <div class="modal fade" id="modalMotivoCancelamento" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Motivo do Cancelamento</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <textarea class="form-control" name="motivoCancelamento" id="motivoCancelamentoInput" rows="4" placeholder="Obrigatório..."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
                        <button type="button" class="btn btn-danger" id="btn-confirmar-envio-cancelamento" disabled>Confirmar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mt-4 text-end">
        @if (modo == "Criar")
        {
            <button type="button" class="btn btn-success" onclick="verificarParcelasAntesDeSalvar()">Finalizar Venda</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        }
        else if (modo == "Detalhes")
        {
            <a asp-action="Index" class="btn btn-secondary">Voltar para Lista</a>
        }
        else if (modo == "Cancelar")
        {
            <input type="hidden" asp-for="Modelo" />
            <input type="hidden" asp-for="Serie" />
            <input type="hidden" asp-for="NumeroNota" />
            

            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalMotivoCancelamento">
                Confirmar Cancelamento
            </button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        }
    </div>
</form>




<div class="modal fade" id="modalCliente" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Selecionar Cliente</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="filtroCliente" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaCliente()" />
                <table class="table table-bordered table-hover" id="tabelaClientesModal">
                    <thead><tr><th>ID</th><th>Nome / Razão Social</th><th>CPF/CNPJ</th><th>Ação</th></tr></thead>
                    <tbody>
                        @if (ViewBag.Clientes != null)
                        {
                            foreach (var cliente in ViewBag.Clientes as List<Pagamento.Models.Cliente>)
                            {
                                <tr>
                                    <td>@cliente.IdPessoa</td>
                                    <td>@cliente.Nome_RazaoSocial</td>
                                    <td>@cliente.CPF_CNPJ</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary" onclick="selecionarCliente(@cliente.IdPessoa, '@cliente.Nome_RazaoSocial', @cliente.IdCondPgto)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div class="mt-3 border-top pt-3">
                    <button type="button" class="btn btn-success" onclick="abrirFormNovoCliente()">
                        <i class="bi bi-person-plus-fill"></i> Cadastrar Novo Cliente
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalProduto" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Selecionar Produto</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="filtroProduto" class="form-control mb-3" placeholder="Buscar produto..." onkeyup="filtrarTabelaProduto()" />
                <table class="table table-bordered table-hover" id="tabelaProdutosModal">
                    <thead><tr><th>ID</th><th>Descrição</th><th>Preço Venda</th><th>Ação</th></tr></thead>
                    <tbody>
                        @if (ViewBag.Produtos != null)
                        {
                            foreach (var produto in ViewBag.Produtos as List<Pagamento.Models.Produto>)
                            {
                                <tr>
                                    <td>@produto.IdProduto</td>
                                    <td>@produto.Descricao</td>
                                    <td>@produto.ValorVenda.ToString("C2")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                onclick="selecionarProduto(@produto.IdProduto, '@produto.Descricao', '@produto.NomeUnidade', @produto.ValorVenda.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @produto.Quantidade)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div class="mt-3 border-top pt-3">
                    <button type="button" class="btn btn-success" onclick="abrirFormNovoProduto()">
                        <i class="bi bi-box-seam"></i> Cadastrar Novo Produto
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalNovoProduto" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovoProdutoContent">
        </div>
    </div>
</div>


<div class="modal fade" id="modalCondicaoVenda" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Selecionar Condição de Pagamento</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="filtroCondicao" class="form-control mb-3" placeholder="Buscar..." onkeyup="filtrarTabelaCondicao()" />
                <table class="table table-bordered table-hover" id="tabelaCondicoesModal">
                    <thead><tr><th>ID</th><th>Descrição</th><th>Ação</th></tr></thead>
                    <tbody>
                        @if (ViewBag.CondicoesPagamento != null)
                        {
                            foreach (var c in ViewBag.CondicoesPagamento as List<Pagamento.Models.CondicaoPagamento>)
                            {
                                <tr>
                                    <td>@c.IdCondPgto</td>
                                    <td>@c.Descricao</td>
                                    
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary" onclick="selecionarCondicaoVenda(@c.IdCondPgto, '@c.Descricao')">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div class="mt-3 border-top pt-3">
                    <button type="button" class="btn btn-success" onclick="abrirFormNovaCondicaoVenda()">
                        <i class="bi bi-plus-circle"></i> Cadastrar Nova Condição
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaCondicao" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovaCondicaoContent">
            <!-- Conteúdo do FormCondicaoPagamento.cshtml será carregado aqui -->
        </div>
    </div>
</div>

<!-- 2. Modal Auxiliar: Seleção de Forma de Pagamento (Para a Nova Condição) -->
<div class="modal fade" id="modalFormaPgtoSelect" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Forma de Pagamento</h5>
                <button type="button" class="btn-close" onclick="fecharModalForma_VoltarCondicao()"></button>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control mb-2" placeholder="Buscar..." onkeyup="filtrarModalSimples(this, '#tabFormaAux')" />
                <div style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-hover" id="tabFormaAux">
                        <thead><tr><th>Descrição</th><th>Ação</th></tr></thead>
                        <tbody>
                            <!-- PREENCHIDO PELO CONTROLLER -->
                            @if (ViewBag.FormasPagamentoItens != null)
                            {
                                foreach (var f in ViewBag.FormasPagamentoItens as List<SelectListItem>)
                                {
                                    <tr>
                                        <td>@f.Text</td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-primary btn-select-forma"
                                                    data-id="@f.Value"
                                                    data-nome="@f.Text">
                                                Selecionar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <button class="btn btn-success w-100 mt-2" onclick="abrirFormNovaFormaPgto()">+ Nova Forma</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaForma" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content" id="modalNovaFormaContent"></div>
    </div>
</div>


<div class="modal fade" id="modalSelecionarFuncionario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header ">
                <h5 class="modal-title">Selecionar Funcionario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" id="filtroFuncionarioInput" class="form-control" placeholder="Digite nome" onkeyup="filtrarTabelaFuncionarios()">
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-bordered table-sm" id="tabelaFuncionarios">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th class="text-center">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Funcionarios != null)
                            {
                                foreach (var func in ViewBag.Funcionarios as List<Pagamento.Models.Funcionario>)
                                {
                                    <tr>
                                        <td>@func.IdPessoa</td>
                                        <td>@func.Nome_RazaoSocial</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    onclick="selecionarFuncionario(@func.IdPessoa, '@func.Nome_RazaoSocial')">
                                                <i class="fa fa-check"></i>
                                                Selecionar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="mt-3 border-top pt-3">
                        <button type="button" class="btn btn-success" onclick="abrirFormNovoFuncionario()">
                            <i class="bi bi-person-plus-fill"></i> Cadastrar Novo Funcionário
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCidadeParaCadastroCliente" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Cidade</h5>
                <button type="button" class="btn-close" onclick="fecharModalCidade_VoltarCliente()"></button>
            </div>
            <div class="modal-body">
