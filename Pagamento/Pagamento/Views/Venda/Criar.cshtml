                const emissao = document.getElementById('DataEmissao').value;

                if(!idCondicao || total <= 0 || !emissao) {
                    alert("Selecione a condição, preencha a data de emissão e adicione produtos."); return;
                }

                try {
                    const res = await fetch(`@Url.Action("ObterDetalhes", "CondicaoPagamento")?id=${idCondicao}`);
                    if(!res.ok) throw new Error("Erro ao buscar condição");
                    const condicao = await res.json();

                    const tbody = document.getElementById('tabela-parcelas');
                    tbody.innerHTML = '';
                    const dataBase = new Date(emissao);

                    const totalEmCentavos = Math.round(total * 100);
                    let somaCentavos = 0;

                    condicao.parcelas.forEach((p, index) => {


                        let valorCentavos = Math.round(totalEmCentavos * (p.valorPercentual / 100));
                        somaCentavos += valorCentavos;

                        if (index === condicao.parcelas.length - 1) {
                            const resto = totalEmCentavos - somaCentavos;
                            valorCentavos += resto;
                        }

                        const valorParcela = valorCentavos / 100;


                        const dataVenc = new Date(dataBase);
                        dataVenc.setDate(dataVenc.getDate() + p.diasAposVenda + 1);           

                        const tr = `<tr>
                            <td>${p.numeroParcela}</td>
                            <td>${formatarMoeda(valorParcela)}</td>
                            <td>${dataVenc.toLocaleDateString('pt-BR')}</td>
                            <td>${p.nomeFormaPagamento || '-'}</td>
                        </tr>`;
                        tbody.insertAdjacentHTML('beforeend', tr);
                    });

                    document.getElementById('fieldset-lista-produtos').disabled = true;

                } catch(e) { console.error(e); alert("Erro ao gerar parcelas"); }
            });


        function filtrarTabelaFuncionarios() {
            var input, filter, table, tr, tds, i, j, txtValue, found;
            input = document.getElementById("filtroFuncionarioInput");
            filter = input.value.toUpperCase();
            table = document.getElementById("tabelaFuncionarios");
            tr = table.getElementsByTagName("tr");

            for (i = 1; i < tr.length; i++) {               
                tds = tr[i].getElementsByTagName("td");
                found = false;
                for (j = 1; j <= 3; j++) {
                    if (tds[j]) {
                        txtValue = tds[j].textContent || tds[j].innerText;
                        if (txtValue.toUpperCase().indexOf(filter) > -1) {
                            found = true;
                            break;                 
                        }
                    }
                }
                tr[i].style.display = found ? "" : "none";
            }
        }

        function selecionarFuncionario(id, nome) {
            document.getElementById('FuncionarioIdInput').value = id;

            document.getElementById('tabela-funcionario-selecionado').innerHTML =
                `<tr><td style="width: 60px;">${id}</td><td>${nome}</td></tr>`;

            var modalEl = document.getElementById('modalSelecionarFuncionario');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            }
        }


            document.getElementById('btn-limpar-parcelas').addEventListener('click', function() {
                 document.getElementById('tabela-parcelas').innerHTML = '';
                 document.getElementById('fieldset-lista-produtos').disabled = false;
            });


        }

        function formatarMoeda(val) {
            return val.toLocaleString('pt-BR', {style: 'currency', currency: 'BRL'});
        }
        function parseMoeda(str) {
            return parseFloat(str.replace('R$', '').trim().replace(/\./g, '').replace(',', '.')) || 0;
        }
        function calcularTotalItem() {
            const qtd = parseFloat(document.getElementById('produto-quantidade').value) || 0;
            const valor = parseMoeda(document.getElementById('produto-valor').value);
            document.getElementById('produto-total').value = formatarMoeda(qtd * valor);
        }
        function atualizarTotais() {
            let total = 0;
            document.querySelectorAll('#tabela-produtos tr').forEach(tr => {
                total += (parseFloat(tr.dataset.qtd) * parseFloat(tr.dataset.valor));
            });
            document.getElementById('total-nota').value = formatarMoeda(total);
        }
        function limparInputsProduto() {
            document.getElementById('IdProdutoSelecionado').value = '';
            document.getElementById('NomeProdutoSelecionado').value = '';
            document.getElementById('NomeProdutoSelecionado').placeholder = '-';
            document.getElementById('UnidadeProdutoSelecionado').value = '';
            document.getElementById('produto-unidade').value = '';
            document.getElementById('produto-quantidade').value = '1';
            document.getElementById('produto-valor').value = '';
            document.getElementById('produto-total').value = '';
            document.getElementById('EstoqueProdutoSelecionado').value = '';
            
        }

        if(modo === "Criar") {
            ['produto-quantidade', 'produto-valor'].forEach(id => {
                document.getElementById(id).addEventListener('input', calcularTotalItem);
            });
        }

         function filtrarTabelaProduto() {
            const filtro = $('#filtroProduto').val().toLowerCase();
            $('#tabelaProdutosModal tbody tr').each(function () {
                const texto = $(this).text().toLowerCase();
                $(this).toggle(texto.includes(filtro));
            });
        }
        function filtrarTabelaCondicao() {
             const filtro = $('#filtroCondicao').val().toLowerCase();
             $('#tabelaCondicoesModal tbody tr').each(function () {
                 const texto = $(this).text().toLowerCase();
                 $(this).toggle(texto.includes(filtro));
             });
        }

        if (modo === "Cancelar") {
            document.addEventListener('DOMContentLoaded', function() {
                const form = document.getElementById('form-venda');
                const btnConfirmarModal = document.getElementById('btn-confirmar-envio-cancelamento');
                const motivoInput = document.getElementById('motivoCancelamentoInput');
                const contadorEl = document.getElementById('contador-caracteres');   

                if (btnConfirmarModal && form && motivoInput) {

                    motivoInput.addEventListener('input', function() {
                        const texto = this.value.trim();
                        const qtdCaracteres = texto.length;

                        if (contadorEl) contadorEl.textContent = qtdCaracteres;

                        if (qtdCaracteres >= 20) {
                            btnConfirmarModal.disabled = false;
                        } else {
                            btnConfirmarModal.disabled = true;
                        }
                    });

                    btnConfirmarModal.addEventListener('click', function() {
                        const motivo = motivoInput.value.trim();

                        if (motivo.length < 20) {
                            alert("O motivo deve ter pelo menos 20 caracteres.");
                            motivoInput.focus();
                            return;
                        }

                        form.submit();
                    });
                }
            });
        }
    </script>
}