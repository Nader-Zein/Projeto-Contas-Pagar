@model List<Pagamento.Models.ContaAReceber>

@{
    ViewData["Title"] = "Contas a Receber";
}

<h1>@ViewData["Title"]</h1>

@* 
           *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Origem (Nº Nota)</th>
                    <th>Cliente</th>
                    <th>Vencimento</th>
                    <th>Valor da Parcela</th>
                    <th>Nº Parcela</th>
                    <th>Situação</th>                   
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string trClass = "";

                    var situacao = (item.Situacao ?? "").Trim().ToUpperInvariant();
                    bool recebido = situacao == "RECEBIDO" || situacao == "RECEBIDA";
                    bool aReceber = situacao == "A RECEBER";

                    if (!item.Status)
                    {
                        trClass = "table-secondary text-decoration-line-through";
                    }
                    else
                    {
                                 
                        bool vencidaEmAberto = aReceber && item.DataVencimento.Date < DateTime.Today;

                                          
                        bool recebidaAtrasada = recebido
                                                && item.DataPagamento.HasValue
                                                && item.DataPagamento.Value.Date > item.DataVencimento.Date;

                        if (recebido)
                        {
                            trClass = recebidaAtrasada ? "table-danger" : "table-success";
                        }
                        else if (vencidaEmAberto)
                        {
                            trClass = "table-danger";
                        }
                    }

                    <tr class="@trClass">
                                
                        <td>
                            @if (!string.IsNullOrEmpty(item.Modelo))
                            {
                                <small>@($"{item.Modelo}/{item.Serie} - {item.NumeroNota}")</small>
                            }
                            else
                            {
                                <small>Avulsa</small>
                            }
                        </td>

                        <td>@item.NomeCliente</td>
                        <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>

                        <td title="@(item.ValorPago.HasValue ? "Valor recebido" : "Valor da parcela")">
                            @{
                                decimal valor = item.ValorPago.GetValueOrDefault(item.ValorParcela);
                            }
                            @valor.ToString("C2")
                        </td>

                        <td>@item.NumeroParcela</td>

                        <td>
                            <span class="badge
                                @(item.Situacao == "RECEBIDO" ? "bg-success" :
                                  (item.Situacao == "A RECEBER" ? "bg-warning text-dark" : "bg-secondary"))">
                                @item.Situacao
                            </span>
                        </td>

                        

                        <td>
                            <span class="badge @(item.Status ? "bg-success" : "bg-danger")">
                                @(item.Status ? "Ativo" : "Cancelado")
                            </span>
                        </td>
                        <td>
                            @{
                                               
                                            
                                string baixarDisabled = (item.Situacao != "A RECEBER" || item.Status == false) ? "disabled" : "";
                                bool cancelarDisabled =
                                                        (item.Situacao ?? "").Trim().Equals("RECEBIDA", StringComparison.OrdinalIgnoreCase)
                                                        || item.Status == false;
                            }
                            
                            @*                                    *@
                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    onclick="location.href='@Url.Action("Criar", new {
                                        modelo = item.Modelo,
                                        serie = item.Serie,
                                        numeroNota = item.NumeroNota,
                                        clienteId = item.ClienteId,
                                        numeroParcela = item.NumeroParcela,
                                        apenasDetalhes = true
                                    })'">
                                Detalhes
                            </button>

                            @*                                    *@
                            <button type="button"
                                    class="btn btn-sm btn-primary btn-verificar-baixa @baixarDisabled"
                                    title="Receber/Baixar"
                                    data-modelo="@item.Modelo"
                                    data-serie="@item.Serie"
                                    data-numero-nota="@item.NumeroNota"
                                    data-cliente-id="@item.ClienteId"
                                    data-numero-parcela="@item.NumeroParcela"
                                    data-url-baixar="@Url.Action("Criar", new { 
                                        modelo = item.Modelo, 
                                        serie = item.Serie, 
                                        numeroNota = item.NumeroNota, 
                                        clienteId = item.ClienteId, 
                                        numeroParcela = item.NumeroParcela 
                                    })">
                                Dar Baixa
                            </button>
                            @*   
                                            
                               
                                            
                                                                                                       *@
                            <button type="button" 
                            class="btn btn-sm btn-danger"
                             disabled="@cancelarDisabled" 
                            data-bs-toggle="modal" 
                            data-bs-target="#modalAvisoCancelamento">
                        Cancelar
                    </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@*                                                                              *@

<div class="modal fade" id="modalAvisoPendencia" tabindex="-1" aria-labelledby="modalAvisoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-warning" id="modalAvisoLabel">Aviso de Pendência</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p id="modalAvisoPendenciaBody">Mensagem de erro.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAvisoErro" tabindex="-1" aria-labelledby="modalAvisoErroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalAvisoErroLabel">Atenção</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @TempData["ErrorMessage"]
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAvisoCancelamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Ação não permitida</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="fw-bold">Não é possível cancelar esta conta por aqui.</p>
                <p>Como esta conta foi gerada automaticamente por uma Venda, você deve realizar o cancelamento diretamente na tela de Vendas.</p>
                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            var mensagemErro = '@TempData["ErrorMessage"]';
            if (mensagemErro && mensagemErro.trim() !== "") {
                var myModal = new bootstrap.Modal(document.getElementById('modalAvisoErro'));
                myModal.show();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            
            const modalElement = document.getElementById('modalAvisoPendencia');
            const modalAviso = new bootstrap.Modal(modalElement);
            const modalBody = document.getElementById('modalAvisoPendenciaBody');

            document.querySelectorAll('.btn-verificar-baixa').forEach(button => {
                
                button.addEventListener('click', async function () {
                    
                    const dataset = this.dataset;
                    const modelo = dataset.modelo || '';
                    const serie = dataset.serie || '';
                    const numeroNota = dataset.numeroNota || 0;
                          
                    const clienteId = dataset.clienteId || 0; 
                    const numeroParcela = dataset.numeroParcela || 0;
                    
                    if (modelo === '') {
                        window.location.href = dataset.urlBaixar;
                        return;
                    }

                            
                    const urlVerificar = `@Url.Action("VerificarPendenciaParcela", "ContaAReceber")?modelo=${encodeURIComponent(modelo)}&serie=${encodeURIComponent(serie)}&numeroNota=${numeroNota}&clienteId=${clienteId}&numeroParcela=${numeroParcela}`;

                    try {
                        const response = await fetch(urlVerificar);
                        if (!response.ok) {
                            throw new Error('Erro ao conectar com o servidor.');
                        }
                        
                        const data = await response.json();

                        if (data.temPendencia) {
                            modalBody.textContent = data.mensagem;
                            modalAviso.show();
                        } else {
                            window.location.href = dataset.urlBaixar;
                        }

                    } catch (error) {
                        modalBody.textContent = 'Erro ao verificar parcela: ' + error.message;
                        modalAviso.show();
                    }
                });
            });
        });
    </script>
}