@model Pagamento.Models.Funcionario

@{
    ViewData["Title"] = "Editar Funcionário";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="IdPessoa" />

    <div class="row">
        <div class="d-flex justify-content-end mt-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="Status" />
                <label class="form-check-label" asp-for="Status">Ativo</label>
            </div>
        </div>

        <div class="col-md-1">
            <label asp-for="IdPessoa" class="form-label">ID</label>
            <input asp-for="IdPessoa" class="form-control" disabled />
        </div>

        <div class="col-md-2 mb-3">
            <label class="form-label">Tipo de Pessoa</label>
            <input type="text" class="form-control" value="Física" disabled />
            <input type="hidden" name="TipoPessoa" value="Física" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Nome_RazaoSocial" class="form-label">Nome </label>
            <input asp-for="Nome_RazaoSocial" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
            <span asp-validation-for="Nome_RazaoSocial" class="text-danger"></span>

        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="Genero" class="form-label">Gênero</label>
            <select asp-for="Genero" class="form-control">
                <option value="">Selecione</option>
                <option value="Masculino">Masculino</option>
                <option value="Feminino">Feminino</option>
                <option value="Outro">Outro</option>
            </select>
            <span asp-validation-for="Genero" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="Matricula" class="form-label">Matrícula</label>
            <input asp-for="Matricula" class="form-control" />
            <span asp-validation-for="Matricula" class="text-danger"></span>
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Endereco" class="form-label">Endereço</label>
            <input asp-for="Endereco" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
            <span asp-validation-for="Endereco" class="text-danger"></span>

        </div>

        <div class="col-md-1 mb-3">
            <label asp-for="Numero" class="form-label">Número</label>
            <input asp-for="Numero" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <span asp-validation-for="Numero" class="text-danger"></span>
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Complemento" class="form-label">Complemento</label>
            <input asp-for="Complemento" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Bairro" class="form-label">Bairro</label>
            <input asp-for="Bairro" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
            <span asp-validation-for="Bairro" class="text-danger"></span>

        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="Cep" class="form-label">CEP</label>
            <input asp-for="Cep" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <span asp-validation-for="Cep" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Cidade</label>
            <div class="input-group">
                <input type="text" id="NomeCidadeSelecionada" class="form-control" value="@ViewBag.NomeCidade" readonly />
                <input type="hidden" asp-for="IdCidade" id="IdCidade" />
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalCidade">
                    Selecionar Cidade
                </button>
            </div>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="DataNascimento_Fundacao" class="form-label">Data de Nascimento</label>
            <input asp-for="DataNascimento_Fundacao" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd") />
            <span asp-validation-for="DataNascimento_Fundacao" class="text-danger"></span>

        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="CPF_CNPJ" class="form-label">CPF</label>
            <input asp-for="CPF_CNPJ" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <span asp-validation-for="CPF_CNPJ" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="RG_InsEstadual" class="form-label">RG</label>
            <input asp-for="RG_InsEstadual" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <span asp-validation-for="RG_InsEstadual" class="text-danger"></span>

        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="Telefone" class="form-label">Telefone</label>
            <input asp-for="Telefone" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <span asp-validation-for="Telefone" class="text-danger"></span>

        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="Cargo" class="form-label">Cargo</label>
            <input asp-for="Cargo" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
            <span asp-validation-for="Cargo" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="Salario" class="form-label">Salário</label>
            <input asp-for="Salario" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Salario" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="Turno" class="form-label">Turno</label>
            <select asp-for="Turno" class="form-control">
                <option value="">Selecione</option>
                <option value="Manhã">Manhã</option>
                <option value="Tarde">Tarde</option>
                <option value="Noite">Noite</option>
                <option value="Integral">Integral</option>
            </select>
            <span asp-validation-for="Turno" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="CargaHoraria" class="form-label text-nowrap">Carga Horária (h/semana)</label>
            <input asp-for="CargaHoraria" class="form-control" type="number" />
            <span asp-validation-for="CargaHoraria" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="DataAdmissao" class="form-label">Data de Admissão</label>
            <input asp-for="DataAdmissao" class="form-control" type="date" />
            <span asp-validation-for="DataAdmissao" class="text-danger"></span>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="DataDemissao" class="form-label">Data de Demissão</label>
            <input asp-for="DataDemissao" class="form-control" type="date" />
        </div>

        <div class="col-md-2 mb-3">
            <label class="form-label">Data de Criação</label>
            <input type="text" class="form-control" value="@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")" readonly />
        </div>

        <div class="col-md-2 mb-3">
            <label class="form-label">Última Edição</label>
            <input type="text" class="form-control"
                   value="@(Model.DataEdicao?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca editado")" readonly />
        </div>
    </div>

    <div class="text-end mt-3">
        <button type="submit" class="btn btn-success">Alterar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

<div class="modal fade" id="modalCidade" tabindex="-1" aria-labelledby="modalCidadeLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Cidade</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="filtroCidade" class="form-control" placeholder="Digite para buscar..." onkeyup="filtrarTabelaCidade()" />
                </div>

                <table class="table table-bordered" id="tabelaCidades">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cidade in ViewBag.Cidades as List<SelectListItem>)
                        {
                            <tr>
                                <td>@cidade.Text</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarCidade(@cidade.Value, '@cidade.Text')">
                                        Selecionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr />
                <button class="btn btn-success" type="button" onclick="abrirFormNovaCidade()">+ Cadastrar nova Cidade</button>
                <div id="formNovaCidadeContainer"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaCidade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalNovaCidadeContent">
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>


        $(document).ready(function () {

            // Função auxiliar para calcular idade em anos completos
            function idadeEmAnos(dataNascStr, dataRefStr) {
                var nasc = new Date(dataNascStr);
                var ref  = dataRefStr ? new Date(dataRefStr) : new Date();

                var idade = ref.getFullYear() - nasc.getFullYear();
                var mes   = ref.getMonth() - nasc.getMonth();

                if (mes < 0 || (mes === 0 && ref.getDate() < nasc.getDate())) {
                    idade--;
                }

                return idade;
            }

            // ===================== 1) Validação de DATA DE NASCIMENTO =====================
            function validarDataNascimento() {
                var dtNascimentoVal = $('#DataNascimento_Fundacao').val();
                if (!dtNascimentoVal) return true; // se não preencheu, deixa outras validações cuidarem

                var dataNasc = new Date(dtNascimentoVal);
                if (dataNasc.getFullYear() < 1900) return true; // usuário ainda digitando

                var hojeStr = new Date().toISOString().split('T')[0];

                // 1.1 Nascimento não pode ser no futuro
                if (dtNascimentoVal > hojeStr) {
                    alert('A Data de Nascimento não pode ser futura.');
                    $('#DataNascimento_Fundacao').focus();
                    return false;
                }

                // 1.2 Idade mínima hoje (se quiser essa regra)
                var idadeHoje = idadeEmAnos(dtNascimentoVal, hojeStr);
                if (idadeHoje < 16) {
                    alert('Erro: o funcionário ainda não tem 16 anos completos hoje.');
                    $('#DataNascimento_Fundacao').focus();
                    return false;
                }

                return true;
            }

            // ===================== 2) Validação de ADMISSÃO e DEMISSÃO =====================
            function validarAdmissaoEDemissao() {
                var dtNascimentoVal = $('#DataNascimento_Fundacao').val();
                var dtAdmissaoVal   = $('#DataAdmissao').val();
                var dtDemissaoVal   = $('#DataDemissao').val();
                var hojeStr         = new Date().toISOString().split('T')[0];

                // ------ 2.1 Valida ADMISSÃO ------
                if (dtAdmissaoVal) {
                    var dataAdm = new Date(dtAdmissaoVal);
                    if (dataAdm.getFullYear() < 1900) return true; // ainda digitando

                    // 2.1.1 Admissão não pode ser futura
                    if (dtAdmissaoVal > hojeStr) {
                        alert('A Data de Admissão não pode ser futura.');
                        $('#DataAdmissao').focus();
                        return false;
                    }

                    // 2.1.2 Idade mínima na data de admissão
                    if (dtNascimentoVal) {
                        var idadeNaAdmissao = idadeEmAnos(dtNascimentoVal, dtAdmissaoVal);
                        if (idadeNaAdmissao < 16) {
                            alert('Erro: o funcionário tinha menos de 16 anos na Data de Admissão.');
                            $('#DataAdmissao').focus();
                            return false;
                        }
                    }

                    // 2.1.3 Admissão não pode ser depois da Demissão
                    if (dtDemissaoVal && dtAdmissaoVal > dtDemissaoVal) {
                        alert('Erro: a Data de Admissão não pode ser posterior à Data de Demissão.');
                        $('#DataAdmissao').focus();
                        return false;
                    }
                }

                // ------ 2.2 Valida DEMISSÃO ------
                if (dtDemissaoVal) {
                    var dataDem = new Date(dtDemissaoVal);
                    if (dataDem.getFullYear() < 1900) return true; // ainda digitando

                    // 👇 Demissão futura é PERMITIDA, então não tem comparação com "hojeStr" aqui

                    // 2.2.1 Demissão não pode ser antes da Admissão
                    if (dtAdmissaoVal && dtDemissaoVal < dtAdmissaoVal) {
                        alert('Erro: a Data de Demissão não pode ser anterior à Data de Admissão.');
                        $('#DataDemissao').focus();
                        return false;
                    }
                }

                return true;
            }

            // ===================== 3) Função principal =====================
            function validarDatasFuncionario() {
                // Se falhar Nascimento OU Admissão/Demissão, bloqueia envio
                return validarDataNascimento() && validarAdmissaoEDemissao();
            }

            // ===================== 4) Valida SOMENTE NO SUBMIT =====================
            $('form').on('submit', function (e) {
                if (!validarDatasFuncionario()) {
                    e.preventDefault();
                }
            });
        });



                $(document).ready(function () {
            // Pega a data de hoje no formato YYYY-MM-DD
            var hoje = new Date().toISOString().split('T')[0];

            // Garante que o atributo max esteja definido via JS também (segurança extra)
            $('#DataNascimento_Fundacao').attr('max', hoje);

            // Evento para verificar quando o usuário muda a data
            $('#DataNascimento_Fundacao').on('change blur', function() {
                var dataSelecionada = $(this).val();

                // Se a data selecionada for maior que hoje
                if (dataSelecionada && dataSelecionada > hoje) {
                    alert("A data não pode ser futura!");
                    $(this).val(hoje); // Reseta para a data de hoje ou use '' para limpar
                }
            });
        });


        function selecionarCidade(id, nome) {
            document.getElementById('IdCidade').value = id;
            document.getElementById('NomeCidadeSelecionada').value = nome;
            var modal = bootstrap.Modal.getInstance(document.getElementById('modalCidade'));
            modal.hide();
        }

        function abrirFormNovaCidade() {
            $.get('@Url.Action("FormModal", "Cidade")', function (data) {
                $('#modalNovaCidadeContent').html(data);
                var modal = new bootstrap.Modal(document.getElementById('modalNovaCidade'));
                modal.show();
            });
        }

        $(document).off('submit', '#formCadastrarCidade');

        $(document).on('submit', '#formCadastrarCidade', function (e) {
            e.preventDefault();

            const $form = $(this);
            const $submitButton = $form.find('button[type=submit]');
            $submitButton.prop('disabled', true);

            $.ajax({
                type: 'POST',
                url: '@Url.Action("FormModal", "Cidade")',
                data: $form.serialize(),
                success: function (response) {
                    if (response.sucesso) {
                        $('#modalNovaCidade').modal('hide');

                        var novaLinha = `<tr>
                            <td>${response.cidade.nome}</td>
                            <td>
                                <button class='btn btn-sm btn-primary' onclick='selecionarCidade(${response.cidade.id}, "${response.cidade.nome}")'>Selecionar</button>
                            </td>
                        </tr>`;
                        $('#tabelaCidades tbody').append(novaLinha);
                    } else {
                        $('#modalNovaCidadeContent').html(response);
                    }
                },
                complete: function () {
                    $submitButton.prop('disabled', false);
                }
            });
        });

        function filtrarTabelaCidade() {
            var input = document.getElementById("filtroCidade");
            var filtro = input.value.toLowerCase();
            var linhas = document.querySelectorAll("#tabelaCidades tbody tr");

            linhas.forEach(function (linha) {
                var nomeCidade = linha.cells[0].textContent.toLowerCase();
                linha.style.display = nomeCidade.includes(filtro) ? "" : "none";
            });
        }
    </script>
}
