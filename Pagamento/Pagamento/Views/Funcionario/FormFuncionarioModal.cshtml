@model Pagamento.Models.Funcionario

<div class="modal-header">
    <h5 class="modal-title">Cadastrar Novo Funcionário</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
</div>

<div class="modal-body">
    <form id="formCadastrarFuncionarioModal">
        <div class="row">

            <div class="d-flex justify-content-end mt-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="Status" checked />
                    <label class="form-check-label" asp-for="Status">Ativo</label>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Tipo de Pessoa</label>
                <input type="text" class="form-control" value="Física" disabled />
                <input type="hidden" asp-for="TipoPessoa" value="Física" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Nome_RazaoSocial" class="form-label">Nome</label>
                <input asp-for="Nome_RazaoSocial" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
                <span asp-validation-for="Nome_RazaoSocial" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Genero" class="form-label">Gênero</label>
                <select asp-for="Genero" class="form-control">
                    <option value="">Selecione</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Feminino">Feminino</option>
                    <option value="Outro">Outro</option>
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Matricula" class="form-label">Matrícula</label>
                <input asp-for="Matricula" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Endereco" class="form-label">Endereço</label>
                <input asp-for="Endereco" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
            </div>

            <div class="col-md-2 mb-3">
                <label asp-for="Numero" class="form-label">Número</label>
                <input asp-for="Numero" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="Bairro" class="form-label">Bairro</label>
                <input asp-for="Bairro" class="form-control" maxlength="40" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="Cep" class="form-label">CEP</label>
                <input asp-for="Cep" class="form-control" id="Funcionario_Cep" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Cidade</label>
                <div class="input-group">
                    <input type="text" id="Funcionario_NomeCidade" class="form-control" placeholder="Selecione..." readonly />
                    <input type="hidden" asp-for="IdCidade" id="Funcionario_IdCidade" />
                    <button type="button" class="btn btn-outline-secondary" onclick="abrirModalCidadeParaFuncionario()">
                        <i class="bi bi-search"></i>
                        Selecionar
                    </button>
                </div>
                <span asp-validation-for="IdCidade" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="DataNascimento_Fundacao" class="form-label">Data Nascimento</label>
                <input asp-for="DataNascimento_Fundacao" type="date" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="CPF_CNPJ" class="form-label">CPF</label>
                <input asp-for="CPF_CNPJ" class="form-control" id="Funcionario_CPF" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                <span asp-validation-for="CPF_CNPJ" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="RG_InsEstadual" class="form-label">RG</label>
                <input asp-for="RG_InsEstadual" class="form-control" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Telefone" class="form-label">Telefone</label>
                <input asp-for="Telefone" class="form-control" id="Funcionario_Telefone" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Cargo" class="form-label">Cargo</label>
                <input asp-for="Cargo" class="form-control" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Salario" class="form-label">Salário</label>
                <input asp-for="Salario" class="form-control" type="number" step="0.01" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Turno" class="form-label">Turno</label>
                <select asp-for="Turno" class="form-control">
                    <option value="">Selecione</option>
                    <option value="Manhã">Manhã</option>
                    <option value="Tarde">Tarde</option>
                    <option value="Noite">Noite</option>
                    <option value="Integral">Integral</option>
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="CargaHoraria" class="form-label">Carga Horária</label>
                <input asp-for="CargaHoraria" class="form-control" type="number" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="DataAdmissao" class="form-label">Data Admissão</label>
                <input asp-for="DataAdmissao" class="form-control" type="date" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="DataDemissao" class="form-label">Data Demissão</label>
                <input asp-for="DataDemissao" class="form-control" type="date" />
            </div>

            <input type="hidden" asp-for="DataCriacao" value="@DateTime.Now" />
        </div>

        <div class="modal-footer px-0 border-0">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-success">Salvar Funcionário</button>
        </div>
    </form>
</div>

<partial name="_ValidationScriptsPartial" />
<script>
    $(document).ready(function() {
        var maskTel = function (val) { return val.replace(/\D/g, '').length === 11 ? '(00) 00000-0000' : '(00) 0000-00009'; },
            optTel = { onKeyPress: function(val, e, field, options) { field.mask(maskTel.apply({}, arguments), options); } };

        $('#Funcionario_Telefone').mask(maskTel, optTel);
        $('#Funcionario_Cep').mask('00000-000');
        $('#Funcionario_CPF').mask('000.000.000-00', {reverse: true});
    });
</script>