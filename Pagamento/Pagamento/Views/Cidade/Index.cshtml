@{
    ViewData["Title"] = "Cidades";
}

@model List<Pagamento.Models.Cidade>

<div class="text-center">
    <h1 class="display-4">Cidades</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="d-flex justify-content-start mb-3">
        <a asp-controller="Cidade" asp-action="Criar" class="btn btn-primary">Criar</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Nome do Estado</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdCidade</td>
                        <td>@item.NomeCidade</td>
                        <td>@item.NomeEstado</td>
                        <td>
                            @if (item.Status)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Desativado</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Cidade" asp-action="Editar" asp-route-id="@item.IdCidade" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-controller="Cidade" asp-action="Excluir" asp-route-id="@item.IdCidade" class="btn btn-danger btn-sm">Excluir</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">Nenhuma cidade encontrada.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="modal fade" id="modalErro" tabindex="-1" aria-labelledby="modalErroLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalErroLabel">Atenção!</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="mensagemErroModal"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Executa este código assim que a página terminar de carregar
        document.addEventListener('DOMContentLoaded', function () {

            // Pega a mensagem de erro que veio do Controller
            const mensagemErro = '@TempData["ErrorMessage"]';

            // Verifica se a mensagem de erro não está vazia
            if (mensagemErro) {
                // Coloca a mensagem dentro do corpo do modal
                document.getElementById('mensagemErroModal').textContent = mensagemErro;

                // Pega a referência do nosso modal
                const modalErroElement = document.getElementById('modalErro');

                // Cria uma instância do modal do Bootstrap e o exibe
                const modal = new bootstrap.Modal(modalErroElement);
                modal.show();
            }
        });
    </script>
}