    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js" integrity="sha512-pHVGpX7F/27gaKFG2fiOKAYbmFNmfDcJARLovDqMDVcxPsnDbCKLDGQcI</em>j7J</strong>20K4VoLhurVDltAJvYcdpfhw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
