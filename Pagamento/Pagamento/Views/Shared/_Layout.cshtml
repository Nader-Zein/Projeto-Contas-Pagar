<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pagamento</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pagamento.styles.css" asp-append-version="true" />

    <style>
    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="password"],
    textarea {
        text-transform: uppercase;
    }

        select {
            text-transform: uppercase;
        }
</style>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Pagamento</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                   
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="cadastroDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Cadastro
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="cadastroDropdown">
                                <li><a class="dropdown-item" asp-controller="FormaPagamento" asp-action="FormaPagamento">Forma de Pagamento</a></li>
                                <li><a class="dropdown-item" asp-controller="CondicaoPagamento" asp-action="Index">Condição de Pagamento</a></li>
                                <li><a class="dropdown-item" asp-controller="Cidade" asp-action="Index">Cidade</a></li>
                                <li><a class="dropdown-item" asp-controller="Estado" asp-action="Index">Estado</a></li>
                                <li><a class="dropdown-item" asp-controller="Pais" asp-action="Index">País</a></li>
                                <li><a class="dropdown-item" asp-controller="Fornecedor" asp-action="Index">Fornecedor</a></li>
                                <li><a class="dropdown-item" asp-controller="Cliente" asp-action="Index">Cliente</a></li>
                                <li><a class="dropdown-item" asp-controller="Funcionario" asp-action="Index">Funcionário</a></li>
                                <li><a class="dropdown-item" asp-controller="Marca" asp-action="Index">Marca</a></li>
                                <li><a class="dropdown-item" asp-controller="UnidadeMedida" asp-action="Index">Unidade de Medida</a></li>
                                <li><a class="dropdown-item" asp-controller="Categoria" asp-action="Index">Categoria</a></li>
                                <li><a class="dropdown-item" asp-controller="Produto" asp-action="Index">Produto</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="operacaoDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Operação
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="operacaoDropdown">
                                <li><a class="dropdown-item" asp-controller="Compra" asp-action="Index">Compra</a></li>

                            </ul>
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Pagamento - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    
