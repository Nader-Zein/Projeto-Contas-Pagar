@model IEnumerable<Pagamento.Models.CondicaoPagamento>

<div class="modal fade" id="modalCondicaoCompra" tabindex="-1" aria-labelledby="modalCondicaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalCondicaoLabel">Selecionar Condição de Pagamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="text" id="filtroCondicao" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaCondicao()" />

                <table class="table table-bordered table-hover" id="tabelaCondicoesCompra">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Descrição</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            @foreach (var condicao in Model)
                            {
                                <tr data-id="@condicao.IdCondPgto">
                                    <td>@condicao.IdCondPgto</td>
                                    <td>@condicao.Descricao</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                onclick="selecionarCondicaoCompra(@condicao.IdCondPgto, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(condicao.Descricao))')">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <hr />
                <button type="button" class="btn btn-success" onclick="abrirFormNovaCondicaoCompra()">
                    + Cadastrar Nova Condição
                </button>
            </div>
        </div>
    </div>
</div>

