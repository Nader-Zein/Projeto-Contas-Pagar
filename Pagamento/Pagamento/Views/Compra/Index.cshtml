@model IEnumerable<Pagamento.Models.Compra>
@using System.Globalization

@{
    ViewData["Title"] = "Lista de Compras";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Criar" class="btn btn-primary">Cadastrar Nova Compra</a>
</p>


<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nota Fiscal (Modelo/Série/Número)</th>
            <th>Fornecedor</th>
            <th>Produtos</th>
            <th>Total da Nota</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var compra in Model)
            {

                string trClass = compra.Status ? "" : "table-danger"; 
                <tr class="@trClass">
                    <td>
                        @compra.Modelo / @compra.Serie / @compra.NumeroNota
                    </td>
                    <td>
                        @compra.NomeFornecedor
                    </td>
                    <td>
                        @if (compra.Itens != null && compra.Itens.Any())
                        {
                            <ul>
                                @foreach (var item in compra.Itens)
                                {
                                    <li>@item.NomeProduto</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>(Sem itens)</span>
                        }
                    </td>
                    <td>
                        @compra.TotalNota.ToString("C", new CultureInfo("pt-BR"))
                    </td>
                    <td>
                        @if (compra.Status)
                        {
                            <span class="badge bg-success">Ativa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Cancelada</span>
                        }
                    </td>
                    <td>

                        @{
                            string cancelarDisabled = (!compra.Status) ? "disabled" : "";
                        }
                        <a asp-action="Detalhes"
                           asp-route-modelo="@compra.Modelo"
                           asp-route-serie="@compra.Serie"
                           asp-route-numeroNota="@compra.NumeroNota"
                           asp-route-fornecedorId="@compra.FornecedorId"
                           class="btn btn-sm btn-info">Detalhes</a>

                        <a asp-action="Cancelar"
                           asp-route-modelo="@compra.Modelo"
                           asp-route-serie="@compra.Serie"
                           asp-route-numeroNota="@compra.NumeroNota"
                           asp-route-fornecedorId="@compra.FornecedorId"
                           class="btn btn-sm btn-danger @cancelarDisabled"
                           aria-disabled="@( !compra.Status ? "true" : "false")">
                            Cancelar
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">Nenhuma compra cadastrada.</td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="modalAvisoErro" tabindex="-1" aria-labelledby="modalAvisoErroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalAvisoErroLabel">Atenção</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @TempData["ErrorMessage"]
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var mensagemErro = '@TempData["ErrorMessage"]';

            if (mensagemErro && mensagemErro.trim() !== "") {
                var myModal = new bootstrap.Modal(document.getElementById('modalAvisoErro'));
                myModal.show();
            }
        });
    </script>
}