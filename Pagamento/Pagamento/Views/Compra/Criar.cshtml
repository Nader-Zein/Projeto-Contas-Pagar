@model Pagamento.Models.Compra

@{
    ViewData["Title"] = "Cadastro de Compra";
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="Criar" method="post" id="form-compra">
    <input type="hidden" name="itensJson" id="itens-json" />
    <input asp-for="FornecedorId" type="hidden" id="FornecedorId" />
    <input asp-for="CondicaoPagamentoId" type="hidden" id="CondicaoPagamentoCompraId" />

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Dados da Nota Fiscal</span>
            <div class="form-check form-switch">
                <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" checked>
                <label asp-for="Status" class="form-check-label">Ativo</label>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-2"><label asp-for="Modelo" class="form-label"></label>
                    <input asp-for="Modelo" class="form-control" />
                    <span asp-validation-for="Modelo" class="text-danger"></span>
                    </div>
                <div class="col-md-2"><label asp-for="Serie" class="form-label"></label>
                    <input asp-for="Serie" class="form-control" />
                    <span asp-validation-for="Serie" class="text-danger"></span>
                    </div>
                <div class="col-md-2"><label asp-for="NumeroNota" class="form-label">Número da Nota</label>
                    <input asp-for="NumeroNota" class="form-control" />
                     <span asp-validation-for="NumeroNota" class="text-danger"></span>
                    </div>
               
                <div class="col-md-6 mt-2">
                    <label class="form-label">Fornecedor</label>
                    <div class="input-group">
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalFornecedor">Buscar Fornecedor</button>
                    </div>
                    <div class="col-md-6 mt-2">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Fornecedor</th>
                                </tr>
                            </thead>
                            <tbody id="tabela-fornecedor-selecionado">
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <div class="row mt-3">
                <div class="col-md-3"><label asp-for="DataEmissao" class="form-label">
                </label><input asp-for="DataEmissao" type="date" class="form-control" />
                <span asp-validation-for="DataEmissao" class="text-danger"></span>
                </div>
                <div class="col-md-3"><label asp-for="DataChegada" class="form-label">
                </label><input asp-for="DataChegada" type="date" class="form-control" />
                    <span asp-validation-for="DataChegada" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Lista de Produtos</div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Produto</label>
                    <div class="input-group">
                        <input type="text" id="NomeProdutoSelecionado" class="form-control" readonly placeholder="Nenhum produto selecionado" />
                        <input type="hidden" id="IdProdutoSelecionado" />
                        <input type="hidden" id="UnidadeProdutoSelecionado" />
                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalProduto" id="btn-buscar-produto">Buscar</button>
                    </div>
                </div>
                <div class="col-md-2"><label class="form-label">Quantidade</label><input id="produto-quantidade" type="number" class="form-control" value="1" /></div>
                <div class="col-md-2"><label class="form-label">Valor Unitário</label><input id="produto-valor" type="text" class="form-control" /></div>
                <div class="col-md-3"><button type="button" id="btn-adicionar-produto" class="btn btn-secondary">Adicionar Produto</button></div>
            </div>
            <table class="table table-hover mt-3">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Produto</th>
                        <th>UN</th>
                        <th>Qtd.</th>
                        <th>Vl. Unitário</th>
                        <th>Total</th>
                        <th>Ação</th>
                    </tr>
                </thead>
                <tbody id="tabela-produtos"></tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Financeiro</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>Valores Totais</h5><hr />
                    <div class="mb-2 row"><label class="col-sm-4 col-form-label">Total Produtos</label><div class="col-sm-8"><input type="text" readonly class="form-control-plaintext" id="total-produtos" value="R$ 0,00"></div></div>
                    <div class="mb-2 row"><label asp-for="Frete" class="col-sm-4 col-form-label"></label><div class="col-sm-8"><input asp-for="Frete" class="form-control" value="0" /></div></div>
                    <div class="mb-2 row"><label asp-for="Seguro" class="col-sm-4 col-form-label"></label><div class="col-sm-8"><input asp-for="Seguro" class="form-control" value="0" /></div></div>
                    <div class="mb-2 row"><label asp-for="Despesas" class="col-sm-4 col-form-label"></label><div class="col-sm-8"><input asp-for="Despesas" class="form-control" value="0" /></div></div>
                    <hr />
                    <div class="mb-2 row fw-bold fs-5"><label class="col-sm-4 col-form-label">Total da Nota</label><div class="col-sm-8"><input type="text" readonly class="form-control-plaintext" id="total-nota" value="R$ 0,00"></div></div>
                </div>
                <div class="col-md-6">
                    <h5>Pagamento</h5><hr />
                    <label class="form-label">Condição de Pagamento</label>
                    <div class="input-group">
                        <input type="text" id="NomeCondicaoCompra" class="form-control" readonly placeholder="Nenhuma condição selecionada" />
                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalCondicaoCompra">Buscar</button>
                    </div>
                    <table class="table table-sm table-bordered mt-2">
                        <thead><tr><th>Parcela</th><th>Valor</th><th>Vencimento</th><th>Forma de Pagamento</th></tr></thead>
                        <tbody id="tabela-parcelas"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <label asp-for="Observacoes" class="form-label">Observações Gerais da Compra</label>
            <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Digite aqui observações gerais sobre a nota, entrega, etc."></textarea>
        </div>
    </div>


    <div class="mt-4 text-end">
        <button type="submit" class="btn btn-success">Salvar Compra</button>
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

<div class="modal fade" id="modalFornecedor" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Selecionar Fornecedor</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="filtroFornecedor" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaFornecedorCompra()" />
                <table class="table table-bordered table-hover" id="tabelaFornecedores">
                    <thead><tr><th>Nome</th><th>Ação</th></tr></thead>              
                    <tbody>
                        @foreach (var fornecedor in ViewBag.Fornecedores as List<Pagamento.Models.Fornecedor>)
                        {
                            <tr>
                                <td>@fornecedor.Nome_RazaoSocial</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarFornecedor(@fornecedor.IdPessoa, '@fornecedor.Nome_RazaoSocial', @fornecedor.IdCondPgto)">
                                        Selecionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-success" onclick="abrirFormNovoFornecedor()">
                    + Cadastrar Novo Fornecedor
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalProduto" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Selecionar Produto</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="filtroProduto" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaProduto()" />
                <table class="table table-bordered table-hover" id="tabelaProdutosModal">
                    <thead><tr><th>Descrição</th><th>Ação</th></tr></thead>
                    <tbody>
                        @foreach (var produto in ViewBag.Produtos as List<Pagamento.Models.Produto>)
                        {
                            <tr>
                                <td>@produto.Descricao</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary" onclick="selecionarProduto(@produto.IdProduto, '@produto.Descricao', '@produto.NomeUnidade')">Selecionar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-success" onclick="abrirFormNovoProduto()">+ Cadastrar novo Produto</button>
            </div>
        </div>
    </div>
</div>




<div class="modal fade" id="modalNovoFornecedor" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovoFornecedorContent">
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovoProduto" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovoProdutoContent">
        </div>
    </div>
</div>



<partial name="_ModalCondicaoPagamento" model="ViewBag.CondicoesPagamento" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>



         function moveFornecedorSubModalsToBody() {
          ['#modalCidadeFornecedor',
           '#modalCondicaoPgtoFornecedor',
           '#modalNovaCidadeFornecedor',
           '#modalNovaCondicaoFornecedor'
          ].forEach(sel => {
            const el = document.querySelector('#modalNovoFornecedorContent ' + sel);
            if (el) document.body.appendChild(el); 
        }

        function openStackedModal(childId, parentId) {
          const parentEl = document.getElementById(parentId);
          const childEl  = document.getElementById(childId);
          if (!childEl) return;

          const parent = bootstrap.Modal.getOrCreateInstance(parentEl);
          const child  = bootstrap.Modal.getOrCreateInstance(childEl);

          parent.hide();
          childEl.addEventListener('hidden.bs.modal', function onHidden() {
            childEl.removeEventListener('hidden.bs.modal', onHidden);
            parent.show();
          }, { once: true });

          child.show();
        }

        function wireFornecedorModal() {
          moveFornecedorSubModalsToBody();

          const root = document.getElementById('modalNovoFornecedorContent');

          const btnCidade = root.querySelector('[data-bs-target="#modalCidadeFornecedor"]');
          if (btnCidade) {
            btnCidade.removeAttribute('data-bs-toggle');
            btnCidade.removeAttribute('data-bs-target');
            btnCidade.addEventListener('click', e => {
              e.preventDefault();
              openStackedModal('modalCidadeFornecedor', 'modalNovoFornecedor');
            });
          }

          const btnCond = root.querySelector('[data-bs-target="#modalCondicaoPgtoFornecedor"]');
          if (btnCond) {
            btnCond.removeAttribute('data-bs-toggle');
            btnCond.removeAttribute('data-bs-target');
            btnCond.addEventListener('click', e => {
              e.preventDefault();
              openStackedModal('modalCondicaoPgtoFornecedor', 'modalNovoFornecedor');
            });
          }
        }



        function cleanupFornecedorSubModals() {
          [
            '#modalCidadeFornecedor',
            '#modalCondicaoPgtoFornecedor',
            '#modalNovaCidadeFornecedor',
            '#modalNovaCondicaoFornecedor'
          ].forEach(sel => {
            document.querySelectorAll(sel).forEach(n => n.remove());
          });

          if (!document.querySelector('.modal.show')) {
            document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
            document.body.classList.remove('modal-open');
          }
        }

        function dedupeFornecedorSubModals() {
          ['modalCidadeFornecedor','modalCondicaoPgtoFornecedor','modalNovaCidadeFornecedor','modalNovaCondicaoFornecedor']
            .forEach(id => {
              const nodes = Array.from(document.querySelectorAll('#' + id));
              if (nodes.length > 1) {
                nodes.slice(0, -1).forEach(n => n.remove());
              }
            });
        }

        
        let idCondicaoPermitida = 0;

        function selecionarFornecedor(id, nome, idCondPgto) {
            document.getElementById('FornecedorId').value = id;
            document.getElementById('tabela-fornecedor-selecionado').innerHTML = `<tr><td>${id}</td><td>${nome}</td></tr>`;

            idCondicaoPermitida = idCondPgto || 0;

            document.getElementById('CondicaoPagamentoCompraId').value = '';
            document.getElementById('NomeCondicaoCompra').value = '';
            document.getElementById('tabela-parcelas').innerHTML = '';

            bootstrap.Modal.getInstance(document.getElementById('modalFornecedor')).hide();

           
        }

        document.addEventListener('DOMContentLoaded', function () {
            const modalCondicaoEl = document.getElementById('modalCondicaoCompra');

            if (modalCondicaoEl) {
                modalCondicaoEl.addEventListener('show.bs.modal', function (event) {

                    if (idCondicaoPermitida === 0) {
                        alert("Por favor, selecione um fornecedor primeiro!");
                        event.preventDefault(); 
                        return;
                    }

                    const todasAsLinhas = modalCondicaoEl.querySelectorAll('#tabelaCondicoes tbody tr');

                    todasAsLinhas.forEach(linha => {
                        const idDaLinha = linha.getAttribute('data-id');

                        if (idDaLinha == idCondicaoPermitida) {
                            linha.style.display = ''; 
                        }
                        
                        else {
                            linha.style.display = 'none';
                        }
                    });
                });
            }

            
        });

        



                
        function abrirFormNovoFornecedor() {
          cleanupFornecedorSubModals(); 

          $.get('@Url.Action("FormModal", "Fornecedor")', function (html) {
            const cont = document.getElementById('modalNovoFornecedorContent');
            cont.innerHTML = html;

            dedupeFornecedorSubModals(); 
            wireFornecedorModal();       

            const el = document.getElementById('modalNovoFornecedor');
            const m  = new bootstrap.Modal(el);
            m.show();

            el.addEventListener('hidden.bs.modal', cleanupFornecedorSubModals, { once: true });
          });
        }




        $(document).on('submit', '#formCadastrarFornecedor', function (e) {
            e.preventDefault();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("FormModal", "Fornecedor")',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.sucesso) {
                        $('#modalNovoFornecedor').modal('hide');

                        var novaLinha = `<tr>
                            <td>${response.fornecedor.nome}</td>
                            <td>
                                <button class='btn btn-sm btn-primary' onclick='selecionarFornecedor(${response.fornecedor.id}, "${response.fornecedor.nome}")'>Selecionar</button>
                            </td>
                        </tr>`;
                        $('#tabelaFornecedores tbody').append(novaLinha);
                    } else {
                        $('#modalNovoFornecedorContent').html(response);
                    }
                }
            });
        });

       

       
        function selecionarCidadeFornecedor(id, nome) {
          $('#modalNovoFornecedorContent #IdCidade').val(id);
          $('#modalNovoFornecedorContent #NomeCidadeSelecionada').val(nome);
          bootstrap.Modal.getInstance(document.getElementById('modalCidadeFornecedor'))?.hide();
        }

       

                
        function abrirFormNovaCidadeFornecedor() {
          const selEl = document.getElementById('modalCidadeFornecedor');
          const sel   = selEl ? bootstrap.Modal.getOrCreateInstance(selEl) : null;
          if (sel) sel.hide();

          $.get('/Cidade/FormModal', function (html) {
            $('#modalNovaCidadeContentFornecedor').html(html);

            const cadEl = document.getElementById('modalNovaCidadeFornecedor');
            const cad   = bootstrap.Modal.getOrCreateInstance(cadEl);

            cadEl.addEventListener('hidden.bs.modal', function onHidden() {
              cadEl.removeEventListener('hidden.bs.modal', onHidden);
              if (sel) sel.show(); 
            }, { once: true });

            cad.show();
          });
        }


        $(document).on('submit', '#formCadastrarCidade', function (e) {
          e.preventDefault();
          $.ajax({
            type: 'POST',
            url: '@Url.Action("FormModal", "Cidade")',
            data: $(this).serialize(),
            success: function (response) {
              if (response.sucesso) {
                bootstrap.Modal.getInstance(document.getElementById('modalNovaCidadeFornecedor')).hide();

                const novaLinha = `
                  <tr>
                    <td>${response.cidade.nome}</td>
                    <td>
                      <button class='btn btn-sm btn-primary'
                              onclick='selecionarCidadeFornecedor(${response.cidade.id}, "${response.cidade.nome}")'>
                        Selecionar
                      </button>
                    </td>
                  </tr>`;
                $('#tabelaCidadesFornecedor tbody').append(novaLinha);
              } else {
                $('#modalNovaCidadeContentFornecedor').html(response);
              }
            }
          });
        });


        function filtrarTabelaCidadeFornecedor() {
          const filtro = $('#filtroCidadeFornecedor').val().toLowerCase();
          $('#tabelaCidadesFornecedor tbody tr').each(function () {
            const nome = $(this).find('td:first').text().toLowerCase();
            $(this).toggle(nome.includes(filtro));
          });
        }



        function filtrarTabelaCidade() {
            const filtro = $('#filtroCidade').val().toLowerCase();
            $('#tabelaCidades tbody tr').each(function () {
                const nome = $(this).find('td:first').text().toLowerCase();
                $(this).toggle(nome.includes(filtro));
            });
        }

        
        function selecionarCondicaoFornecedor(id, nome) {
          $('#modalNovoFornecedorContent #IdCondPgto').val(id);
          $('#modalNovoFornecedorContent #NomeCondicaoSelecionada').val(nome);
          bootstrap.Modal.getInstance(document.getElementById('modalCondicaoPgtoFornecedor'))?.hide();
        }

       

                
        function abrirFormNovaCondicaoFornecedor() {
          const selEl = document.getElementById('modalCondicaoPgtoFornecedor');
          const sel   = selEl ? bootstrap.Modal.getOrCreateInstance(selEl) : null;
          if (sel) sel.hide();

          $.get('/CondicaoPagamento/FormModal', function (html) {
            $('#modalNovaCondicaoContentFornecedor').html(html);

            const cadEl = document.getElementById('modalNovaCondicaoFornecedor');
            const cad   = bootstrap.Modal.getOrCreateInstance(cadEl);

            cadEl.addEventListener('hidden.bs.modal', function onHidden() {
              cadEl.removeEventListener('hidden.bs.modal', onHidden);
              if (sel) sel.show();
            }, { once: true });

            cad.show();
          });
        }


        function filtrarTabelaCondicao() {
            const filtro = $('#filtroCondicao').val().toLowerCase();
            $('#tabelaCondicoes tbody tr').each(function () {
                const nome = $(this).find('td:first').text().toLowerCase();
                $(this).toggle(nome.includes(filtro));
            });
        }

        function selecionarFormaPgto(id, nome) {
            $('#IdFormaPgto').val(id);
            $('#NomeFormaSelecionada').val(nome);
            bootstrap.Modal.getInstance(document.getElementById('modalFormaPgto')).hide();
        }

        function filtrarTabelaForma() {
            const filtro = $('#filtroForma').val().toLowerCase();
            $('#tabelaFormas tbody tr').each(function () {
                const texto = $(this).find('td:first').text().toLowerCase();
                $(this).toggle(texto.includes(filtro));
            });
        }

        function abrirFormNovaForma() {
            $.get('/FormaPagamento/FormModal', function (html) {
                $('#modalNovaFormaContent').html(html);
                new bootstrap.Modal(document.getElementById('modalNovaForma')).show();
            });
        }

        $(document).on('submit', '#formCadastrarFormaPgto', function (e) {
            e.preventDefault();
            $.ajax({
                type: 'POST',
                url: '/FormaPagamento/FormModal',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.sucesso) {
                        $('#modalNovaForma').modal('hide');

                        const novaLinha = `
                            <tr>
                                <td>${response.forma.nome}</td>
                                <td>
                                    <button type='button' class='btn btn-sm btn-primary'
                                        onclick='selecionarFormaPgto(${response.forma.id}, "${response.forma.nome}")'>
                                        Selecionar
                                    </button>
                                </td>
                            </tr>`;
                        $('#tabelaFormas tbody').append(novaLinha);
                    } else {
                                $('#modalNovaFormaContent').html(response);
                           }
                }

            });
        });

        let parcelas = [];

        $(document).on('click', '#btnAdicionarParcela', function () {
            const numeroParcela = parseInt($('#NumeroParcela').val());
            const idForma = parseInt($('#IdFormaPgto').val());
            const nomeForma = $('#NomeFormaSelecionada').val();
            const valor = parseFloat($('#ValorPercentual').val());
            const dias = parseInt($('#DiasAposVenda').val());

            if (!numeroParcela || !idForma || !nomeForma || isNaN(valor) || isNaN(dias)) {
                alert("Preencha todos os campos da parcela corretamente.");
                return;
            }

            if (parcelas.some(p => p.numeroParcela === numeroParcela)) {
                alert("Já existe uma parcela com esse número.");
                return;
            }

            const parcela = {
                numeroParcela: numeroParcela,
                idFormaPgto: idForma,
                descricaoFormaPgto: nomeForma,
                valorPercentual: valor,
                diasAposVenda: dias
            };

            parcelas.push(parcela);

            const linha = `
                <tr data-numero="${numeroParcela}">
                    <td>${numeroParcela}</td>
                    <td>${nomeForma}</td>
                    <td>${valor}%</td>
                    <td>${dias} dias</td>
                    <td><button type="button" class="btn btn-danger btn-sm removerParcela">Remover</button></td>
                </tr>`;
            $('#tabelaParcelas tbody').append(linha);

            $('.removerParcela').off('click').on('click', function () {
                const tr = $(this).closest('tr');
                const num = parseInt(tr.attr('data-numero'));
                parcelas = parcelas.filter(p => p.numeroParcela !== num);
                tr.remove();
            });

            $('#NumeroParcela').val('');
            $('#ValorPercentual').val('');
            $('#DiasAposVenda').val('');
            $('#IdFormaPgto').val('');
            $('#NomeFormaSelecionada').val('');
        });

        
        $(document).on('submit', '#formCadastrarCondicaoPgto', function (e) {
          e.preventDefault();

          const formData = $(this).serializeArray();
          formData.push({ name: "ParcelasJson", value: JSON.stringify(parcelas) });

          $.ajax({
            type: 'POST',
            url: '/CondicaoPagamento/FormModal',
            data: $.param(formData),
            success: function (response) {
              if (response.sucesso) {
                bootstrap.Modal.getInstance(document.getElementById('modalNovaCondicaoFornecedor')).hide();

                const linha = `
                  <tr>
                    <td>${response.condicao.nome}</td>
                    <td>
                      <button type='button' class='btn btn-sm btn-primary'
                        onclick='selecionarCondicaoFornecedor(${response.condicao.id}, "${response.condicao.nome}")'>
