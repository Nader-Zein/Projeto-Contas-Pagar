@model Pagamento.Models.Compra

@{
    string modo = ViewData["Modo"] as string ?? "Criar";
    ViewData["Title"] = modo == "Criar" ? "Cadastro de Compra" : (modo == "Detalhes" ? "Detalhes da Compra" : "Cancelar Compra");
    bool isReadOnly = (modo != "Criar");                
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="@(modo == "Cancelar" ? "ConfirmarCancelamento" : "Criar")" method="post" id="form-compra">
    <input type="hidden" name="itensJson" id="itens-json" />
    <input asp-for="FornecedorId" type="hidden" id="FornecedorId" />
    <input asp-for="CondicaoPagamentoId" type="hidden" id="CondicaoPagamentoCompraId" />

    <fieldset @(isReadOnly ? "disabled" : "")>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Dados da Nota Fiscal</span>
            <div class="form-check form-switch">
                <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" checked>
                <label asp-for="Status" class="form-check-label">Ativo</label>
            </div>
        </div>
        <div class="card-body">
          <fieldset id="fieldset-dados-nota">
            <div class="row">
                <div class="col-md-2"><label asp-for="Modelo" class="form-label"></label>
                    <input asp-for="Modelo" class="form-control" />
                    <span asp-validation-for="Modelo" class="text-danger"></span>
                    </div>
                <div class="col-md-2"><label asp-for="Serie" class="form-label"></label>
                    <input asp-for="Serie" class="form-control" />
                    <span asp-validation-for="Serie" class="text-danger"></span>
                    </div>
                <div class="col-md-2"><label asp-for="NumeroNota" class="form-label">Número da Nota</label>
                    <input asp-for="NumeroNota" class="form-control" />
                     <span asp-validation-for="NumeroNota" class="text-danger"></span>
                    </div>
               
                <div class="col-md-6">
                    <label class="form-label">Fornecedor</label>
                    @if (modo == "Criar")
                        {
                    <div class="input-group">
                        <input type="number" id="fornecedor-id-input" class="form-control" placeholder="Digitar ID" style="max-width: 120px;" />

                        <button type="button" id="btn-buscar-por-id" class="btn btn-primary">Buscar por ID</button>
                        
                        <button type="button" class="btn btn-outline-secondary ms-4" data-bs-toggle="modal" data-bs-target="#modalFornecedor">Buscar Fornecedor</button>
                    </div>
                    <div class="col-md-6 mt-2">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Fornecedor</th>
                                </tr>
                            </thead>
                            <tbody id="tabela-fornecedor-selecionado">
                            </tbody>
                        </table>
                    </div>
                      }
                        else
                        {
                            <input type="text" class="form-control" value="@Model.NomeFornecedor (ID: @Model.FornecedorId)" readonly />
                        }
                </div>

                

            </div>
            <div class="row mt-3">
                <div class="col-md-3">
                    <label asp-for="DataEmissao" class="form-label"> Data de Emissao*</label>
                    <input asp-for="DataEmissao" type="date" class="form-control" id="DataEmissao" /> 
                </div>
                <div class="col-md-3">
                    <label asp-for="DataChegada" class="form-label">Data de Chegada</label>
                    <input asp-for="DataChegada" type="date" class="form-control" id="DataChegada" /> 
                </div>
            </div>
          </fieldset>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Lista de Produtos</div>
        <div class="card-body">
          <fieldset id="fieldset-lista-produtos" disabled>
           @if (modo == "Criar")
                {
                    <div class="row align-items-end gx-2">
                        <div class="col-md-auto">
                    <label class="form-label">Produto</label>
                    <div class="input-group">
                        <input type="number" id="produto-id-input" class="form-control" placeholder="Digitar ID..." style="max-width: 120px;" />
                        <button type="button" id="btn-buscar-produto-por-id" class="btn btn-primary">Buscar ID</button>
                        <button class="btn btn-outline-secondary ms-2" type="button" data-bs-toggle="modal" data-bs-target="#modalProduto" id="btn-buscar-produto-modal" title="Abrir lista de produtos">Buscar</button>
                    </div>
                  
                </div>

                <div class="col-md-2">
                    <label class="form-label">Produto Selecionado</label>
                    <input type="text" id="NomeProdutoSelecionado" class="form-control" readonly placeholder="-" />
                    <input type="hidden" id="IdProdutoSelecionado" />
                    <input type="hidden" id="UnidadeProdutoSelecionado" />
                </div>
                <div class="col-md-1">
                    <label class="form-label">UN</label>
                    <input id="produto-unidade" type="text" class="form-control" readonly />
                </div>

                <div class="col-md-1">
                    <label class="form-label">Quantidade</label>
                    <input id="produto-quantidade" type="number" class="form-control" value="1" />
                </div>

                <div class="col-md-1">
                    <label class="form-label">Valor Unitário</label>
                    <input id="produto-valor" type="text" class="form-control" />
                </div>

                <div style="width: 12.5%;">
                    <label class="form-label">Total</label>
                    <input id="produto-total" type="text" class="form-control" readonly />
                </div>

                            
                <div class="col-md-auto d-flex gap-1 ms-3 align-self-end">                
                <button type="button" id="btn-adicionar-produto" class="btn btn-secondary flex-grow-1">Adicionar</button>
                <button type="button" id="btn-limpar-produtos" class="btn btn-outline-danger" title="Limpar lista e desbloquear dados da nota">
                <i class="bi bi-trash"></i> Limpar       
                </button>            
                </div>
            </div>
            }
            <table class="table table-hover mt-3">
                <thead>
                    <tr>
                            <th>ID</th>
                            <th>Produto</th>                           
                            <th>UN.</th>
                            <th>Qtd.</th>
                            <th>Vl. Unitário</th>
                            <th>Total</th>
                            @if (modo == "Criar")
                            {
                                <th>Ação</th>
                            }
                    </tr>
                </thead>
                <tbody id="tabela-produtos">
                        @if (isReadOnly)
                        {
                            foreach (var item in Model.Itens)
                            {
                                <tr>
                                    <td>@item.ProdutoId</td>
                                    <td>@item.NomeProduto</td>
                                    <td>@item.NomeUnidade</td>
                                    <td>@item.Quantidade</td>
                                    <td>@item.ValorUnitario.ToString("C2")</td>
                                    <td>@item.Total.ToString("C2")</td>
                                </tr>
                            }
                        }
                </tbody>

            </table>
          </fieldset>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Financeiro</div>
        <div class="card-body">
          <fieldset id="fieldset-financeiro" disabled>
            <div class="mb-4">
                    <h5>Valores Totais</h5><hr />
                    <div class="mb-2 row"><label class="col-sm-4 col-form-label">Total Produtos</label><div class="col-sm-2"><input type="text" readonly class="form-control-plaintext" id="total-produtos" value="@(isReadOnly? Model.TotalProdutos.ToString("C2") : "R$ 0,00")"></div></div>
                    <div class="mb-2 row"><label asp-for="Frete" class="col-sm-4 col-form-label"></label><div class="col-sm-2"><input asp-for="Frete"  type="text" class="form-control" value="@(modo == "Criar" ? "0" : Model.Frete)"  /></div></div>
                    <div class="mb-2 row"><label asp-for="Seguro" class="col-sm-4 col-form-label"></label><div class="col-sm-2"><input asp-for="Seguro" type="text" class="form-control" value="@(modo == "Criar" ? "0" : Model.Seguro)"  /></div></div>
                    <div class="mb-2 row"><label asp-for="Despesas" class="col-sm-4 col-form-label"></label><div class="col-sm-2"><input asp-for="Despesas" type="text" class="form-control" value="@(modo == "Criar" ? "0" : Model.Despesas)" /></div></div>
                    <hr />
                    <div class="mb-2 row fw-bold fs-5"><label class="col-sm-4 col-form-label">Total da Nota</label><div class="col-sm-2"><input type="text" readonly class="form-control-plaintext" id="total-nota" value="@(isReadOnly? Model.TotalNota.ToString("C2") : "R$ 0,00")"></div></div>
                </div>
            <div>
                <h5>Pagamento</h5><hr />
                <label class="form-label">Condição de Pagamento</label>
                <div class="row">
                    <div class="col-md-8">
                             <div class="input-group flex-grow-1">
                            <input type="text" id="NomeCondicaoCompra" class="form-control" readonly
                                       placeholder="@(isReadOnly ? "" : "Nenhuma condição selecionada")"
                                       value="@(isReadOnly? ViewBag.NomeCondicaoPagamento: "")" />
                            @if (modo == "Criar")
                                {

                                    
                            <input type="number"
                                   id="condicao-id-input"
                                   class="form-control"
                                   placeholder="ID"
                                   style="max-width: 100px;" />

                            <button type="button"
                                    id="btn-buscar-condicao-por-id"
                                    class="btn btn-primary">
                                Buscar ID
                            </button>
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalCondicaoCompra">Buscar</button>
                                }

                                @if (modo == "Criar")   
                                {
                                    <button type="button" id="btn-gerar-parcelas" class="btn btn-dark ms-3 text-nowrap">Gerar Parcelas</button>
                                    <button type="button" id="btn-limpar-parcelas" class="btn btn-outline-danger ms-1 text-nowrap">Limpar Parcelas</button>    
                                }
                            </div>
                    </div>
                </div>
                
                    <table class="table table-sm table-bordered mt-2">
                        <thead><tr><th>Parcela</th><th>Valor</th><th>Vencimento</th><th>Forma de Pagamento</th></tr></thead>
                        <tbody id="tabela-parcelas">
                            @if (isReadOnly)
                            {
                                foreach (var p in Model.ParcelasGeradas)
                                {
                                    <tr>
                                        <td>@p.NumeroParcela</td>
                                        <td>@p.ValorParcela.ToString("C2")</td>
                                        <td>@p.DataVencimento.ToString("dd/MM/yyyy")</td>
                                        <td>@p.NomeFormaPgto</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
            </div>
          </fieldset>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <label asp-for="Observacoes" class="form-label">Observações Gerais da Compra</label>
            <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Digite aqui observações gerais sobre a nota, entrega, etc."></textarea>
        </div>
    </div>

   </fieldset>


    @if (modo == "Cancelar")
    {
        <div class="modal fade" id="modalMotivoCancelamento" tabindex="-1" aria-labelledby="modalMotivoLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalMotivoLabel">Motivo do Cancelamento</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <p>Por favor, descreva o motivo do cancelamento desta compra:</p>

                        <textarea class="form-control"
                              id="motivoCancelamentoInput"
                              name="motivoCancelamento"
                              rows="4"
                              placeholder="O motivo é obrigatório..."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>

                        <button type="button" class="btn btn-danger" id="btn-confirmar-envio-cancelamento">Confirmar Cancelamento</button>
                    </div>
                </div>
            </div>
        </div>
    }

   
   <div class="mt-4 text-end">
        @if (modo == "Criar")
        {
            <button type="submit" class="btn btn-success">Salvar Compra</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        }
 else if (modo == "Detalhes") {
        <a asp-action="Index" class="btn btn-secondary">Voltar para Lista</a>
        } else if (modo == "Cancelar") {
        <input type="hidden" asp-for="Modelo" />
        <input type="hidden" asp-for="Serie" />
        <input type="hidden" asp-for="NumeroNota" />
        <input type="hidden" asp-for="FornecedorId" />

            <button type="button"
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#modalMotivoCancelamento">
                Confirmar Cancelamento
            </button>

        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        }
    </div>
</form>

<partial name="_ModalCondicaoPagamento" model="ViewBag.CondicoesPagamento" />


@if (modo == "Criar")
{

<div class="modal fade" id="modalFornecedor" tabindex="-1" >
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Selecionar Fornecedor</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="filtroFornecedor" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaFornecedorCompra()" />
                <table class="table table-bordered table-hover" id="tabelaFornecedores">
                    <thead><tr><th>ID</th><th>Nome</th><th>Ação</th></tr></thead>              
                    <tbody>
                        @foreach (var fornecedor in ViewBag.Fornecedores as List<Pagamento.Models.Fornecedor>)
                        {
                            <tr>
                                <td>@fornecedor.IdPessoa</td>
                                <td>@fornecedor.Nome_RazaoSocial</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarFornecedor(@fornecedor.IdPessoa, '@fornecedor.Nome_RazaoSocial', @fornecedor.IdCondPgto)">
                                        Selecionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-success" onclick="abrirFormNovoFornecedor()">
                    + Cadastrar Novo Fornecedor
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalProduto" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Selecionar Produto</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="filtroProduto" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaProduto()" />
                <table class="table table-bordered table-hover" id="tabelaProdutosModal">
                    <thead><tr><th>ID</th><th>Descrição</th><th>Ação</th></tr></thead>
                    <tbody>
                        @foreach (var produto in ViewBag.Produtos as List<Pagamento.Models.Produto>)
                        {
                            <tr>
                                <td>@produto.IdProduto</td>
                                <td>@produto.Descricao</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary" onclick="selecionarProduto(@produto.IdProduto, '@produto.Descricao', '@produto.NomeUnidade')">Selecionar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-success" onclick="abrirFormNovoProduto()">+ Cadastrar novo Produto</button>
            </div>
        </div>
    </div>
</div>




<div class="modal fade" id="modalNovoFornecedor" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovoFornecedorContent">
        </div>
    </div>
</div>



<div class="modal fade" id="modalNovoProduto" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovoProdutoContent">
        </div>
    </div>
</div>



<div class="modal fade" id="modalMarcaSelecionar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="filtroMarca" class="form-control mb-2" placeholder="Buscar..." onkeyup="filtrarTabelaMarca()" />
                <table class="table table-bordered" id="tabelaMarcas">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                         @foreach (var marca in ViewBag.MarcasItens as List<SelectListItem>)
                        {
                            <tr>
                                <td>@marca.Text</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarMarca(@marca.Value, '@marca.Text')">
                                        Selecionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />
                    <button class="btn btn-success" type="button" onclick="abrirFormMarca()">+ Cadastrar nova Marca excluir</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalUnidadeSelecionar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Unidade de Medida</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="filtroUnidade" class="form-control mb-2" placeholder="Buscar..." onkeyup="filtrarTabelaUnidade()" />
                <table class="table table-bordered" id="tabelaUnidades">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unidade in ViewBag.UnidadesItens as List<SelectListItem>)
                        {
                            <tr>
                                <td>@unidade.Text</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarUnidade(@unidade.Value, '@unidade.Text')">
                                        Selecionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />
                    <button class="btn btn-success" type="button" onclick="abrirFormUnidade()">+ Cadastrar nova Unidade excluir</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCategoriaSelecionar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Categoria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="filtroCategoria" class="form-control mb-2" placeholder="Buscar..." onkeyup="filtrarTabelaCategoria()" />
                <table class="table table-bordered" id="tabelaCategorias">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categoria in ViewBag.CategoriasItens as List<SelectListItem>)
                        {
                            <tr>
                                <td>@categoria.Text</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarCategoria(@categoria.Value, '@categoria.Text')">
                                        Selecionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />
                <button class="btn btn-success" type="button" onclick="abrirFormCategoria()">+ Cadastrar nova Categoria excluir</button>
            </div>
        </div>
    </div>
</div>

    <div class="modal fade" id="modalFornecedorSelecionarProduto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Selecionar Fornecedores (Produto)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <input type="text" id="filtroFornecedorProduto" class="form-control mb-2" placeholder="Buscar..." onkeyup="filtrarTabelaFornecedorProduto()" />

                    <table class="table table-bordered" id="tabelaFornecedoresProduto">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.FornecedoresItens != null)
                            {
                                foreach (var t in ViewBag.FornecedoresItens as List<SelectListItem>)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="chk-fornecedor-produto" value="@t.Value" data-nome="@t.Text" />
                                        </td>
                                        <td>@t.Text</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <h6 class="mt-3">Fornecedores Selecionados:</h6>
                    <ul id="listaFornecedoresSelecionadosProduto"></ul>

                    <hr />
                    <button class="btn btn-success" type="button" onclick="abrirFormNovoFornecedor()">+ Cadastrar novo Fornecedor excluir</button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-primary" onclick="confirmarSelecaoFornecedorProduto()">Selecionar</button>
                </div>
            </div>
        </div>
    </div>

<div class="modal fade" id="modalMarca" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" id="modalMarcaContent"></div></div>
</div>
<div class="modal fade" id="modalUnidade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" id="modalUnidadeContent"></div></div>
</div>
<div class="modal fade" id="modalCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" id="modalCategoriaContent"></div></div>
</div>
<div class="modal fade" id="modalFornecedorProduto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl"><div class="modal-content" id="modalFornecedorProdutoContent"></div></div>
</div>




<div class="modal fade" id="modalCidadeFornecedor" tabindex="-1" aria-labelledby="modalCidadeFornecedorLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCidadeFornecedorLabel">Selecionar Cidade</h5>
