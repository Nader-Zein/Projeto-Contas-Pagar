            if (btnBuscarId) {
                btnBuscarId.addEventListener('click', buscarEselecionarFornecedorPorId);
            }
        });


        document.addEventListener('DOMContentLoaded', function() {

            function getFormattedDate(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            const today = new Date();
            today.setHours(0, 0, 0, 0);                 
            const formattedToday = getFormattedDate(today);

            const dataEmissaoInput = document.getElementById('DataEmissao');
            const dataChegadaInput = document.getElementById('DataChegada');

            if (dataEmissaoInput) {
                dataEmissaoInput.max = formattedToday;

                dataEmissaoInput.addEventListener('input', function() {
                    if (dataChegadaInput) {
                        dataChegadaInput.min = dataEmissaoInput.value;

                        if (dataChegadaInput.value < dataEmissaoInput.value) {
                            dataChegadaInput.value = '';         
                        }
                    }
                });
            }

            if (dataChegadaInput) {
                dataChegadaInput.max = formattedToday;

                if (dataEmissaoInput && dataEmissaoInput.value) {
                     dataChegadaInput.min = dataEmissaoInput.value;
                } else {
                }
            }

        if (dataEmissaoInput) {
            dataEmissaoInput.addEventListener('blur', function() {
                const parts = this.value.split('-');
                if (parts.length === 3) {
                     const inputDate = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2]));

                    if (inputDate > today) {
                        alert('A Data de Emissão não pode ser futura. Corrigindo para hoje.');
                        this.value = formattedToday;       
                        this.dispatchEvent(new Event('input'));
                    }
                } else if (this.value !== '') {
                     alert('Formato de data inválido para Data de Emissão.');
                     this.value = formattedToday;           
                     this.dispatchEvent(new Event('input'));
                }
            });
        }

        if (dataChegadaInput) {
            dataChegadaInput.addEventListener('blur', function() {
                const parts = this.value.split('-');
                if (parts.length === 3) {
                     const inputDate = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2]));

                     let dataEmissaoValue = '';
                     let dataEmissaoDate = null;
                     if (dataEmissaoInput && dataEmissaoInput.value) {
                          dataEmissaoValue = dataEmissaoInput.value;
                          const emissaoParts = dataEmissaoValue.split('-');
                          if (emissaoParts.length === 3) {
                              dataEmissaoDate = new Date(Date.UTC(emissaoParts[0], emissaoParts[1] - 1, emissaoParts[2]));
                          }
                     }

                     if (inputDate > today) {
                         alert('A Data de Chegada não pode ser futura. Corrigindo para hoje.');
                         this.value = formattedToday;
                     } else if (dataEmissaoDate && inputDate < dataEmissaoDate) {
                         alert('A Data de Chegada não pode ser anterior à Data de Emissão. Corrigindo para a Data de Emissão.');
                         this.value = dataEmissaoValue;             
                     }
                } else if (this.value !== '') {
                     alert('Formato de data inválido para Data de Chegada.');
                     this.value = '';       
                }
            });
        }

            if (dataEmissaoInput) {
                dataEmissaoInput.dispatchEvent(new Event('input'));
            }
        });

