                nomeInput.placeholder = 'Nenhum produto selecionado';
            }
        }

         
        function parseMoeda(valorString) {
            if (!valorString) return 0;
            let valorNumerico = valorString.replace('R$', '').trim().replace(/\./g, '').replace(',', '.');
            return parseFloat(valorNumerico) || 0;
        }

        
        function formatarData(data) {
            const dia = String(data.getDate()).padStart(2, '0');
            const mes = String(data.getMonth() + 1).padStart(2, '0'); 
            const ano = data.getFullYear();
            return `${dia}/${mes}/${ano}`;
        }

        function formatarMoeda(valor) {
            const n = parseFloat(valor);
            if (isNaN(n)) return (0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            return n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function atualizarTotais() {
            let totalProdutos = 0;
            document.getElementById('tabela-produtos').querySelectorAll('tr').forEach(l => {
                const q = parseFloat(l.dataset.quantidade || '0');
                const v = parseFloat(l.dataset.valorUnitario || '0');
                totalProdutos += (q * v);
            });

            const frete = parseMoeda(document.getElementById('Frete')?.value || '0');
            const seguro = parseMoeda(document.getElementById('Seguro')?.value || '0');
            const despesas = parseMoeda(document.getElementById('Despesas')?.value || '0');

            const totalNota = totalProdutos + frete + seguro + despesas;

            document.getElementById('total-produtos').value = formatarMoeda(totalProdutos);
            document.getElementById('total-nota').value = formatarMoeda(totalNota);
            
            gerarParcelas(); 
        }



       
        document.addEventListener('DOMContentLoaded', function () {
            const btnAdicionarProduto = document.getElementById('btn-adicionar-produto');
            const tabelaProdutosBody  = document.getElementById('tabela-produtos');

            if (btnAdicionarProduto && tabelaProdutosBody) {
                btnAdicionarProduto.addEventListener('click', function () {
                    const produtoIdInput   = document.getElementById('IdProdutoSelecionado');
                    const produtoNomeInput = document.getElementById('NomeProdutoSelecionado');
                    const unidadeInput = document.getElementById('UnidadeProdutoSelecionado'); 
                    const quantidadeInput  = document.getElementById('produto-quantidade');
                    const valorInput       = document.getElementById('produto-valor');

                    if (!produtoIdInput?.value || !quantidadeInput?.value || !valorInput?.value) {
                        alert('Por favor, selecione um produto e preencha a quantidade e o valor.');
                        return;
                    }

                    const quantidade   = parseFloat(quantidadeInput.value);
                    const valorUnitario= parseFloat((valorInput.value || '').replace(',', '.'));

                    if (!(quantidade > 0) || !(valorUnitario > 0)) {
                        alert('A quantidade e o valor devem ser maiores que zero.');
                        return;
                    }

                    const produtoId   = produtoIdInput.value;
                    const produtoNome = produtoNomeInput?.value || '';
                    const totalItem   = (quantidade * valorUnitario).toFixed(2);

                    const unidadeNome = unidadeInput.value;
                    const linha = document.createElement('tr');
                    linha.dataset.produtoId     = produtoId;
                    linha.dataset.quantidade    = quantidade;
                    linha.dataset.valorUnitario = valorUnitario.toFixed(2);

                    linha.innerHTML = `
                    <td>${produtoId}</td>
                    <td>${produtoNome}</td>
                    <td>${unidadeNome}</td>
                    <td>${quantidade}</td>
                    <td>${formatarMoeda(valorUnitario)}</td>
                    <td>${formatarMoeda(totalItem)}</td>
                    <td><button type="button" class="btn btn-danger btn-sm btn-remover">Remover</button></td>
                    `;
                    tabelaProdutosBody.appendChild(linha);

                    
                    if (produtoIdInput) produtoIdInput.value = '';
                    if (unidadeInput) unidadeInput.value = ''; 
                    if (produtoNomeInput) {
                        produtoNomeInput.value = '';
                        produtoNomeInput.placeholder = 'Nenhum produto selecionado';
                    }
                    if (quantidadeInput) quantidadeInput.value = '1';
                    if (valorInput) valorInput.value = '';

                    atualizarTotais();
                });

                
                tabelaProdutosBody.addEventListener('click', function (e) {
                    const btn = e.target.closest('.btn-remover');
                    if (!btn) return;
                    btn.closest('tr')?.remove();
                    atualizarTotais();
                });
            }

           
            ['Frete', 'Seguro', 'Despesas'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('input', atualizarTotais);
            });

            
            const form = document.getElementById('form-compra');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const itens = [];
                    const linhas = document.getElementById('tabela-produtos')?.querySelectorAll('tr') || [];
                    linhas.forEach(l => {
                        itens.push({
                            ProdutoId: parseInt(l.dataset.produtoId),
                            Quantidade: parseFloat(l.dataset.quantidade),
                            ValorUnitario: parseFloat(l.dataset.valorUnitario)
                        });
                    });

                    if (itens.length === 0) {
                        alert('É necessário adicionar pelo menos um produto à nota.');
                        e.preventDefault();
                        return;
                    }

                    const hidden = document.getElementById('itens-json');
                    if (hidden) hidden.value = JSON.stringify(itens);
                });
            }
        });
    </script>
