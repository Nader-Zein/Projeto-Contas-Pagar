@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    

    <script>
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:\.\d{3})*)(?:,\d*)?$/.test(value);
        };

        $.validator.methods.range = function (value, element, param) {
            if (!value) return true;
            var globalizedValue = value.replace(/\./g, "").replace(",", ".");
            return this.optional(element) || (parseFloat(globalizedValue) >= param[0] && parseFloat(globalizedValue) <= param[1]);
        };
    </script>


    <script>

      const modo = "@modo";

      if (modo == "Criar")
      {

            async function buscarEselecionarCondicaoPorId() {
                const idInput = document.getElementById('condicao-id-input');
                const id = parseInt(idInput.value);

                if (!id || id <= 0) {
                    alert('Por favor, digite um ID de condição válido.');
                    return;
                }

                try {
                    const response = await fetch(`@Url.Action("BuscarPorIdJSON", "CondicaoPagamento")?id=${id}`);

                    if (!response.ok) {
                        const errorData = await response.json().catch(() => null);
                        alert(errorData?.mensagem || 'Condição de pagamento não encontrada.');
                        return;
                    }

                    const condicao = await response.json();

                    const idCond =
                        condicao.idCondPgto ??
                        condicao.id ??
                        condicao.idCondicao ??
                        id;

                    const descricao =
                        condicao.descricao ??
                        condicao.nome ??
                        condicao.Descricao ??
                        "";

                    selecionarCondicaoCompra(idCond, descricao);

                    idInput.value = '';

                } catch (error) {
                    console.error('Erro ao buscar condição por ID:', error);
                    alert('Ocorreu um erro de comunicação ao tentar buscar a condição.');
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                const btnBuscarCondicaoId = document.getElementById('btn-buscar-condicao-por-id');
                if (btnBuscarCondicaoId) {
                    btnBuscarCondicaoId.addEventListener('click', buscarEselecionarCondicaoPorId);
                }
            });

            const btnLimparParcelas = document.getElementById('btn-limpar-parcelas');
            if (btnLimparParcelas) {
                btnLimparParcelas.addEventListener('click', function() {
                    document.getElementById('tabela-parcelas').innerHTML = '';

                    document.getElementById('fieldset-lista-produtos').disabled = false;

                });
            }

            const btnLimparProdutos = document.getElementById('btn-limpar-produtos');
            if (btnLimparProdutos) {
                btnLimparProdutos.addEventListener('click', function() {

                    const temItens = document.getElementById('tabela-produtos').children.length > 0;
                        const temSelecao = document.getElementById('IdProdutoSelecionado').value !== "";
                        if (!temItens && !temSelecao) return;

                    document.getElementById('tabela-produtos').innerHTML = '';

                    limparSelecaoProduto();                 
                    document.getElementById('produto-quantidade').value = '1';
                    document.getElementById('produto-valor').value = '';
                    document.getElementById('produto-total').value = '';

                    atualizarTotais();

                    document.getElementById('tabela-parcelas').innerHTML = '';

                    document.getElementById('fieldset-financeiro').disabled = true;

                    document.getElementById('fieldset-dados-nota').disabled = false;
                });
            }

            const condicoesMap = {};
            @if (ViewBag.CondicoesPagamento != null)
            {
                    foreach (var c in ViewBag.CondicoesPagamento as List<Pagamento.Models.CondicaoPagamento>)
                    {
                            @:condicoesMap[@c.IdCondPgto] = "@Html.Raw(c.Descricao)";
                    }
            }
    $(document).on('change', '#modalFornecedorSelecionar .chk-fornecedor', function () {
        atualizarListaVisualFornecedores();
    });

    function atualizarListaVisualFornecedores() {
        const listaContainer = document.getElementById('listaFornecedoresSelecionados');
        listaContainer.innerHTML = '';         

        $('#modalFornecedorSelecionar .chk-fornecedor:checked').each(function () {
            const nome = $(this).data('nome');
            
            const li = document.createElement('li');
            li.textContent = nome;
            li.className = "text-success"; 
            
            listaContainer.appendChild(li);
        });
    }

    function confirmarSelecaoFornecedor() {
        const ids = [];
        const nomes = [];

        $('#modalFornecedorSelecionar .chk-fornecedor:checked').each(function () {
            ids.push($(this).val());
            nomes.push($(this).data('nome'));
        });

        if (ids.length === 0) {
            alert("Selecione pelo menos um fornecedor para este produto.");
            return;
        }

        const formProduto = $('#modalNovoProdutoContent');

        formProduto.find('#FornecedorIds').val(ids.join(',')); 
        
        formProduto.find('#NomeFornecedorSelecionado').val(nomes.join(', '));

        bootstrap.Modal.getInstance(document.getElementById('modalFornecedorSelecionar')).hide();
    }

        function filtrarTabelaFornecedorProduto() {
            var filtro = document.getElementById("filtroFornecedorProduto").value.toLowerCase();
            var linhas = document.querySelectorAll("#tabelaFornecedoresProduto tbody tr");
            linhas.forEach(function (linha) {
                var nome = linha.cells[1].textContent.toLowerCase();
                linha.style.display = nome.includes(filtro) ? "" : "none";
            });
        }

        $(document).on('change', '.chk-fornecedor-produto', function () {
            const ul = document.getElementById('listaFornecedoresSelecionadosProduto');
            ul.innerHTML = '';         

            $('.chk-fornecedor-produto:checked').each(function () {
                const nome = $(this).data('nome');
                const li = document.createElement('li');
                li.textContent = nome;
                li.className = "text-success";
                ul.appendChild(li);
            });
        });


        function confirmarSelecaoFornecedorProduto() {
            const ids = [];
            const nomes = [];

            $('.chk-fornecedor-produto:checked').each(function () {
                ids.push($(this).val());
                nomes.push($(this).data('nome'));
            });

            if (ids.length === 0) {
                alert("Selecione pelo menos um fornecedor.");
                return;
            }

            const formProduto = $('#modalNovoProdutoContent');

            if (formProduto.length > 0) {
                formProduto.find('#fornecedoresSelecionados').val(ids.join(','));
