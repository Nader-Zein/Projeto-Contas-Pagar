        let parcelas = [];

        $(document).on('click', '#btnAdicionarParcela', function () {
            const numeroParcela = parseInt($('#NumeroParcela').val());
            const idForma = parseInt($('#IdFormaPgto').val());
            const nomeForma = $('#NomeFormaSelecionada').val();
            const valor = parseFloat($('#ValorPercentual').val());
            const dias = parseInt($('#DiasAposVenda').val());

            if (!numeroParcela || !idForma || !nomeForma || isNaN(valor) || isNaN(dias)) {
                alert("Preencha todos os campos da parcela corretamente.");
                return;
            }

            if (parcelas.some(p => p.numeroParcela === numeroParcela)) {
                alert("Já existe uma parcela com esse número.");
                return;
            }

                let totalAtual = parcelas.reduce((sum, p) => sum + p.valorPercentual, 0);

                if (totalAtual + valor > 100) {
                    alert("A soma das parcelas não pode ultrapassar 100%. Total atual: " + totalAtual + "%. Restante permitido: " + (100 - totalAtual) + "%.");
                    return;
                }

            const parcela = {
                numeroParcela: numeroParcela,
                idFormaPgto: idForma,
                descricaoFormaPgto: nomeForma,
                valorPercentual: valor,
                diasAposVenda: dias
            };

            parcelas.push(parcela);

            const linha = `
                <tr data-numero="${numeroParcela}">
                    <td>${numeroParcela}</td>
                    <td>${nomeForma}</td>
                    <td>${valor}%</td>
                    <td>${dias} dias</td>
                    <td><button type="button" class="btn btn-danger btn-sm removerParcela">Remover</button></td>
                </tr>`;
            $('#tabelaParcelas tbody').append(linha);

            $('.removerParcela').off('click').on('click', function () {
                const tr = $(this).closest('tr');
                const num = parseInt(tr.attr('data-numero'));
                parcelas = parcelas.filter(p => p.numeroParcela !== num);
                tr.remove();
            });

            $('#NumeroParcela').val('');
            $('#ValorPercentual').val('');
            $('#DiasAposVenda').val('');
            $('#IdFormaPgto').val('');
            $('#NomeFormaSelecionada').val('');
        });


        $(document).on('submit', '#formCadastrarCondicaoPgto', function (e) {
            e.preventDefault();


            var totalPercentual = parcelas.reduce((soma, p) => soma + (parseFloat(p.valorPercentual) || 0), 0);

                if (Math.abs(totalPercentual - 100) > 0.001) {
                alert("A soma das parcelas deve ser exatamente 100%. Total atual: " + totalPercentual.toFixed(2) + "%");
                return;           
            }
            var isContextoCompra = $('#modalNovaCondicaoCompra').hasClass('show');

            const formData = $(this).serializeArray();
            formData.push({ name: "ParcelasJson", value: JSON.stringify(parcelas) });

            $.ajax({
                type: 'POST',
                url: '@Url.Action("FormModal", "CondicaoPagamento")',
                data: $.param(formData),
                success: function (response) {
                    if (response.sucesso) {

                        if (isContextoCompra) {
                            var modalEl = document.getElementById('modalNovaCondicaoCompra');
                            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                            modal.hide();

                            var novaLinha = `<tr data-id="${response.condicao.id}">
                                <td>${response.condicao.id}</td>
                                <td>${response.condicao.nome}</td>
                                <td>
                                   <button type="button" class="btn btn-sm btn-primary"
                                           onclick='selecionarCondicaoCompra(${response.condicao.id}, "${response.condicao.nome}")'>
                                       Selecionar
                                   </button>
                                </td>
                            </tr>`;
                            $('#tabelaCondicoesCompra tbody').append(novaLinha);

                        } else {
                            var modalEl = document.getElementById('modalNovaCondicaoFornecedor');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            if (modal) modal.hide();

                            const linha = `
                              <tr>
                                <td>${response.condicao.id}</td>
                                <td>${response.condicao.nome}</td>
                                <td>
                                  <button type='button' class='btn btn-sm btn-primary'
                                    onclick='selecionarCondicaoFornecedor(${response.condicao.id}, "${response.condicao.nome}")'>
                                    Selecionar
                                  </button>
                                </td>
                              </tr>`;
                            $('#tabelaCondicoesFornecedor tbody').append(linha);

                            $('#IdCondPgto').val(response.condicao.id);
                            $('#NomeCondicaoSelecionada').val(response.condicao.nome);
                        }

                        parcelas = [];

                    } else {
                        if (isContextoCompra) {
                            $('#modalNovaCondicaoContentCompra').html(response);
                        } else {
                            $('#modalNovaCondicaoContentFornecedor').html(response);
                        }
                    }
                },
                error: function () {
                    alert("Erro ao cadastrar condição. Verifique os campos e tente novamente.");
                }
            });
        });




