            }

            var modalEl = document.getElementById('modalFornecedorSelecionarProduto');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }

        async function verificarChaveDuplicada() {
            const modeloInput = document.getElementById('Modelo');     
            const serieInput = document.getElementById('Serie');       
            const numeroNotaInput = document.getElementById('NumeroNota');     
            const fornecedorIdInput = document.getElementById('FornecedorId');       

            const modelo = modeloInput?.value?.trim() || '';
            const serie = serieInput?.value?.trim() || '';
            const numeroNota = numeroNotaInput?.value?.trim() || '';
            const fornecedorId = parseInt(fornecedorIdInput?.value || '0');

            if (modelo && serie && numeroNota && fornecedorId > 0) {
                console.log('Verificando chave:', modelo, serie, numeroNota, fornecedorId);       

                try {
                    const url = `@Url.Action("VerificarChaveExistente", "Compra")?modelo=${encodeURIComponent(modelo)}&serie=${encodeURIComponent(serie)}&numeroNota=${encodeURIComponent(numeroNota)}&fornecedorId=${fornecedorId}`;

                    const response = await fetch(url);

                    if (!response.ok) {
                        console.error('Erro na resposta do servidor ao verificar chave:', response.statusText);
                        return;                     
                    }

                    const resultado = await response.json();

                    let modalToShow = null;

                    if (resultado.existe) {
                        console.log("Entrou no bloco if (resultado.existe)");     

                        const compraDetalhes = resultado.compra;
                        console.log("Detalhes recebidos:", compraDetalhes);     
                        document.getElementById('compra-existente-modelo').textContent = compraDetalhes.modelo || '-';
                        document.getElementById('compra-existente-serie').textContent = compraDetalhes.serie || '-';
                        document.getElementById('compra-existente-numero').textContent = compraDetalhes.numeroNota || '-';
                        document.getElementById('compra-existente-fornecedor').textContent = `${compraDetalhes.fornecedorId} - ${compraDetalhes.nomeFornecedor || 'N/A'}`;
                        document.getElementById('compra-existente-emissao').textContent = formatarDataString(compraDetalhes.dataEmissao);       
                        document.getElementById('compra-existente-chegada').textContent = formatarDataString(compraDetalhes.dataChegada);       
                        document.getElementById('compra-existente-obs').textContent = compraDetalhes.observacoes || '(Nenhuma)';

                        console.log("Campos do modal preenchidos");     

                        modalToShow = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCompraExistente'));

                      } else if (resultado.existeAvulsa) {
                          const contaAvulsa = resultado.contaAvulsa;

                          document.getElementById('avulsa-modelo').textContent = contaAvulsa.modelo || '-';
                          document.getElementById('avulsa-serie').textContent = contaAvulsa.serie || '-';
                          document.getElementById('avulsa-numero').textContent = contaAvulsa.numeroNota || '-';
                          document.getElementById('avulsa-fornecedor').textContent = `${contaAvulsa.fornecedorId} - ${contaAvulsa.nomeFornecedor || 'N/A'}`;
                          document.getElementById('avulsa-parcela').textContent = contaAvulsa.numeroParcela || '-';
                          document.getElementById('avulsa-vencimento').textContent = formatarDataString(contaAvulsa.dataVencimento);
                          document.getElementById('avulsa-valor').textContent = formatarMoeda(contaAvulsa.valorParcela);
                          document.getElementById('avulsa-situacao').textContent = contaAvulsa.situacao || 'N/D';

                          modalToShow = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalContaAvulsaExistente'));
                      }

                          if (modalToShow) {
                              modalToShow.show();

                              if (modeloInput) modeloInput.value = '';
                              if (serieInput) serieInput.value = '';
                              if (numeroNotaInput) numeroNotaInput.value = '';
                              if (fornecedorIdInput) fornecedorIdInput.value = '';

                              const tabelaFornecedor = document.getElementById('tabela-fornecedor-selecionado');
                              if (tabelaFornecedor) tabelaFornecedor.innerHTML = '';
                              const fornecedorIdInputDisplay = document.getElementById('fornecedor-id-input');
                              if(fornecedorIdInputDisplay) fornecedorIdInputDisplay.value = '';


                               document.getElementById('CondicaoPagamentoCompraId').value = '';
                               document.getElementById('NomeCondicaoCompra').value = '';
                               document.getElementById('tabela-parcelas').innerHTML = '';
                               idCondicaoPermitida = 0;         

                              console.log("Campos do formulário limpos");
                              modeloInput?.focus();
                          }
                        
                    

                } catch (error) {
                    console.error('Erro ao verificar chave duplicada:', error);
                }
            } 
        }

        document.addEventListener('DOMContentLoaded', function() {
            const modeloInput = document.getElementById('Modelo');
            const serieInput = document.getElementById('Serie');
            const numeroNotaInput = document.getElementById('NumeroNota');
            if(modeloInput) modeloInput.addEventListener('blur', verificarChaveDuplicada);
            if(serieInput) serieInput.addEventListener('blur', verificarChaveDuplicada);
            if(numeroNotaInput) numeroNotaInput.addEventListener('blur', verificarChaveDuplicada);

