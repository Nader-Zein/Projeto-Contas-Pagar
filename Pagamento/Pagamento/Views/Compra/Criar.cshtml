        async function selecionarCondicaoCompra(id, descricao) {
            
            document.getElementById('CondicaoPagamentoCompraId').value = id;
            document.getElementById('NomeCondicaoCompra').value = descricao;

           
            var modalEl = document.getElementById('modalCondicaoCompra');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal && modalEl.classList.contains('show')) {
                modal.hide();
            }

           
            await gerarParcelas();
        }
       

        
        async function gerarParcelas() {
            const idCondicao = parseInt(document.getElementById('CondicaoPagamentoCompraId').value);
            const totalNotaStr = document.getElementById('total-nota').value;
            const totalNotaNum = parseMoeda(totalNotaStr);
            const dataEmissaoInput = document.getElementById('DataEmissao');

            
            if (!idCondicao || totalNotaNum <= 0) {
                document.getElementById('tabela-parcelas').innerHTML = '';
                return;
            }

            if (!dataEmissaoInput.value) {
                
                alert("Por favor, preencha a Data de Emissão para calcular os vencimentos.");
                return;
            }

           
            try {
                const [ano, mes, dia] = dataEmissaoInput.value.split('-');
                const dataBase = new Date(ano, mes - 1, dia);

                const response = await fetch(`@Url.Action("ObterDetalhes", "CondicaoPagamento")?id=${idCondicao}`);
                if (!response.ok) {
                    throw new Error('Não foi possível buscar os detalhes da condição de pagamento.');
                }
                const condicao = await response.json();

              

                const tabelaParcelasBody = document.getElementById('tabela-parcelas');
                tabelaParcelasBody.innerHTML = ''; 

                condicao.parcelas.forEach(p => {
                    const valorParcela = totalNotaNum * (p.valorPercentual / 100);
                    const dataVencimento = new Date(dataBase.valueOf());
                    dataVencimento.setDate(dataVencimento.getDate() + p.diasAposVenda);

                    const novaLinha = `
                        <tr>
                            <td>${p.numeroParcela}</td>
                            <td>${formatarMoeda(valorParcela)}</td>
                            <td>${formatarData(dataVencimento)}</td>
                            <td>${p.nomeFormaPagamento}</td>
                        </tr>`;
                    tabelaParcelasBody.insertAdjacentHTML('beforeend', novaLinha);
                });
            } catch (error) {
                console.error('Erro ao gerar parcelas:', error);
                alert('Ocorreu um erro ao gerar as parcelas.');
            }
        }


                
