@model Pagamento.Models.ContaAPagar

@{
    string modo = ViewData["Modo"] as string ?? "Criar";
    ViewData["Title"] = (modo == "Criar") ? "Cadastro de Conta a Pagar" :
                    (modo == "Baixar") ? "Baixa de Conta a Pagar" :
                    (modo == "Cancelar") ? "Cancelamento de Conta a Pagar" :
                    "Detalhes da Conta";

    bool isCriar = (modo == "Criar");
    bool isBaixar = (modo == "Baixar");
    bool isCancelar = (modo == "Cancelar");
    bool isDetalhes = (modo == "Detalhes");
    bool isReadOnly = (isBaixar || isCancelar || isDetalhes);
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-10">
        <form asp-action="@(isCriar ? "CriarAvulsa" : (isBaixar ? "Baixar" : "Cancelar"))" method="post" id="form-conta-pagar">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="FornecedorId" id="FornecedorId" />
            <input type="hidden" asp-for="IdFormaPgto" id="IdFormaPgto" />

            @if (isBaixar || isCancelar || isDetalhes)
            {
                <input type="hidden" asp-for="Modelo" />
                <input type="hidden" asp-for="Serie" />
                <input type="hidden" asp-for="NumeroNota" />
                <input type="hidden" asp-for="NumeroParcela" />
            }

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Dados da Conta</span>
                    <div class="form-check form-switch">
                        <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" disabled="@isReadOnly">
                        <label asp-for="Status" class="form-check-label">Ativo</label>
                    </div>
                </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-md-2">
                            <label asp-for="Modelo" class="form-label">Modelo</label>
                            <input asp-for="Modelo" class="form-control" readonly="@isReadOnly" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Serie" class="form-label">Série</label>
                            <input asp-for="Serie" class="form-control" readonly="@isReadOnly" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="NumeroNota" class="form-label">Nº Nota</label>
                            <input asp-for="NumeroNota" class="form-control" type="number" readonly="@isReadOnly" />
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="FornecedorId" class="form-label">Fornecedor</label>
                            <div class="input-group">

                                <input type="number" id="FornecedorIdInput" class="form-control" placeholder="ID" style="max-width: 80px;" disabled="@isReadOnly" />
                                <button class="btn btn-primary" type="button" id="btnBuscarFornecedorPorId" disabled="@isReadOnly">Buscar ID</button>
                                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalFornecedor" disabled="@isReadOnly">Buscar</button>
                            
                            
                               <input type="text" id="NomeFornecedor" asp-for="NomeFornecedor" class="form-control" placeholder="Nenhum fornecedor selecionado" readonly />
                                
                                
                                
                            </div>
                            <span asp-validation-for="FornecedorId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        
                        <div class="col-md-2">
                            <label asp-for="NumeroParcela" class="form-label text-nowrap ">Número da Parcela</label>
                            <input asp-for="NumeroParcela" class="form-control" type="number" readonly="@isReadOnly" />
                            <span asp-validation-for="NumeroParcela" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="DataEmissao" class="form-label">Data de Emissão</label>
                            <input asp-for="DataEmissao" type="date" class="form-control" readonly="@isReadOnly" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="DataVencimento" class="form-label text-nowrap">Data de Vencimento</label>
                            <input asp-for="DataVencimento" type="date" class="form-control" id="DataVencimento" readonly="@isReadOnly" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="ValorParcela" class="form-label">Valor da Parcela</label>
                            <input asp-for="ValorParcela" class="form-control" type="text" id="ValorParcela" readonly="@isReadOnly" />
                            <span asp-validation-for="ValorParcela" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        
                    </div>

                </div>
            </div>

            

            @* 8. O card de "Termos" (Juros, Multa, etc.) é separado *@
            <div class="card mt-3">
                <div class="card-header">
                    Termos e Forma de Pagamento
                </div>
                <div class="card-body">

                    @* --- LINHA 1: PORCENTAGENS (Bloqueadas na Baixa) --- *@
                    <div class="row mb-1">
                        <div class="col-md-12">
                            <h6 class="text-muted">Taxas Configuradas (%)</h6>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-2">
                            <label asp-for="Juros" class="form-label small">Juros (%)</label>
                            @* Note que adicionamos readonly="@isBaixar" aqui *@
                            <input asp-for="Juros" class="form-control bg-light" type="text"  placeholder="0,00" id="JurosPercentual"
                                   readonly="@(isBaixar || isCancelar || isDetalhes)" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Multa" class="form-label small">Multa (%)</label>
                            <input asp-for="Multa" class="form-control bg-light" type="text"  placeholder="0,00" id="MultaPercentual"
                                   readonly="@(isBaixar || isCancelar || isDetalhes)" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Desconto" class="form-label small">Desconto (%)</label>
                            <input asp-for="Desconto" class="form-control bg-light" type="text"  placeholder="0,00" id="DescontoPercentual"
                                   readonly="@(isBaixar || isCancelar || isDetalhes)" />
                        </div>
                    </div>

                    @if (isBaixar || isDetalhes && Model.Situacao == "PAGO")
                    {
                        <div class="row mb-1">
                            <div class="col-md-12">
                                <h6>Valores Calculados (R$)</h6>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-2">
                                <label asp-for="ValJuros" class="form-label fw-bold">Valor Juros (R$)</label>
                                <input asp-for="ValJuros" type="text" class="form-control money" oninput="somarTotalFinal()" readonly="@(isDetalhes)" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="ValMulta" class="form-label fw-bold">Valor Multa (R$)</label>
                                <input asp-for="ValMulta" type="text" class="form-control money" oninput="somarTotalFinal()" readonly="@(isDetalhes)" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="ValDesconto" class="form-label fw-bold text-nowrap">Valor Desconto (R$)</label>
                                <input asp-for="ValDesconto" type="text" class="form-control money" oninput="somarTotalFinal()" readonly="@(isDetalhes)" />
                            </div>
                            @if (isBaixar || (isDetalhes && Model.Situacao == "PAGO"))
                            {
                                <div class="col-md-2 ps-4">
                                <label asp-for="ValorPago" class="form-label fw-bold text-nowrap">Valor Pago (Calculado)</label>

                                <input class="form-control" type="text" id="ValorPagoDisplay" readonly />

                                <input asp-for="ValorPago" type="hidden" id="ValorPagoHidden" />

                                <span asp-validation-for="ValorPago" class="text-danger"></span>
                            </div>
                            }
                    
                        </div>
                    }

                    <div class="row mb-3">
                        
                        @if (isBaixar || (isDetalhes && Model.Situacao == "PAGO"))
                            {
                                <div class="col-md-3">
                                <label asp-for="DataPagamento" class="form-label fw-bold text-nowrap">Data de Pagamento</label>
                                <input asp-for="DataPagamento" type="date" class="form-control" id="DataPagamento" readonly="@isDetalhes" />
                                <span asp-validation-for="DataPagamento" class="text-danger"></span>
								</div>
                            }

                            <div class="col-md-6">
                            <label asp-for="IdFormaPgto" class="form-label">Forma de Pagamento</label>
                            <div class="input-group">
                                
                            
                                <input type="number" id="FormaPgtoIdInput" class="form-control" placeholder="ID" style="max-width: 80px;" disabled="@(isCancelar || isDetalhes)" />
                                <button class="btn btn-primary" type="button" id="btnBuscarFormaPgtoPorId" disabled="@(isCancelar || isDetalhes)">Buscar ID</button>

                                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalFormaPagamento" disabled="@(isCancelar || isDetalhes)">Buscar</button>
                                <input type="text" id="NomeFormaPgto" asp-for="NomeFormaPgto" class="form-control" placeholder="Nenhuma forma de pagamento selecionada" readonly />
                                
                                
                            </div>
                            </div>
                    </div>
                </div>
            </div>

            @if (isCancelar)
            {
                <input type="hidden" asp-for="Motivo_Cancelamento" id="Motivo_Cancelamento_Hidden" />
            }
            

            @if (isCancelar)
            {
                <div class="modal fade" id="modalMotivoCancelamento" tabindex="-1" aria-labelledby="modalMotivoLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modalMotivoLabel">Motivo do Cancelamento</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body">
                                <p>Por favor, descreva o motivo do cancelamento desta compra:</p>

                                <textarea class="form-control"
                                      id="motivoCancelamentoInput"
                                      
                                      rows="4"
                                      placeholder="O motivo é obrigatório..."></textarea>

                                <div id="validation-motivo-modal" class="text-danger mt-2" style="display: none;">
                                    O motivo é obrigatório.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>

                                <button type="button" class="btn btn-danger" id="btn-confirmar-envio-cancelamento">Confirmar Cancelamento</button>
                            </div>
                        </div>
                    </div>
                </div>
            }




            @if (isDetalhes && Model.Status == false)
            {
                <div class="card mt-3">
                    <div class="card-header bg-danger text-white">
                        Motivo do Cancelamento
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Motivo_Cancelamento" class="form-label fw-bold"> Motivo</label>
                                <textarea asp-for="Motivo_Cancelamento" class="form-control" rows="3" readonly></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            }


            <div class="card mt-3">
                <div class="card-footer text-end">
                    <a asp-action="Index" class="btn btn-secondary">Voltar</a>

                    @if (isCriar)
                    {
                        <button type="submit" class="btn btn-success">Salvar Conta</button>
                    }
                    @if (isBaixar)
                    {
                        <button type="submit" class="btn btn-primary">Confirmar Baixa</button>
                    }
                     @if (isCancelar)
                    {
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalMotivoCancelamento">
                            Confirmar Cancelamento
                        </button>
                    }
                    
                </div>
            </div>

        </form>
    </div>
</div>


<div class="modal fade" id="modalFornecedor" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">Selecionar Fornecedor</h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <input type="text" id="filtroFornecedor" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaFornecedor()" />

                <table class="table table-bordered table-hover" id="tabelaFornecedores">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Nome</th>

                            <th>Ação</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var fornecedor in (List<Fornecedor>)ViewBag.Fornecedores)

                        {

                            <tr>

                                <td>@fornecedor.IdPessoa</td>

                                <td>@fornecedor.Nome_RazaoSocial</td>

                                <td>

                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarFornecedor(@fornecedor.IdPessoa, '@fornecedor.Nome_RazaoSocial.Replace("'", "\\'")')">

                                        Selecionar

                                    </button>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

                <button type="button" class="btn btn-success" onclick="abrirFormNovoFornecedor()">
                    + Cadastrar Novo Fornecedor
                </button>

            </div>

        </div>

    </div>

</div>



<div class="modal fade" id="modalFormaPagamento" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">Selecionar Forma de Pagamento</h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <input type="text" id="filtroFormaPgto" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaFormaPgto()" />

                <table class="table table-bordered table-hover" id="tabelaFormasPagamento">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Descrição</th>

                            <th>Ação</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var forma in (List<FormaPagamento>)ViewBag.FormasPagamento)

                        {

                            <tr>

                                <td>@forma.IdFormaPgto</td>

                                <td>@forma.Descricao</td>

                                <td>

                                    <button type="button" class="btn btn-sm btn-primary"
                                            onclick="selecionarFormaPgto(@forma.IdFormaPgto, '@forma.Descricao.Replace("'", "\\'")')">

                                        Selecionar

                                    </button>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

                <button class="btn btn-success" type="button" onclick="abrirFormNovaFormaPagamento()">
                    + Cadastrar Nova Forma
                </button>

            </div>

        </div>

    </div>

</div>

<div class="modal fade" id="modalCompraExistente" tabindex="-1" aria-labelledby="modalCompraExistenteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-warning" id="modalCompraExistenteLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Atenção: Compra Duplicada Encontrada
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p>Já existe uma compra registrada com os dados informados:</p>
                <dl class="row">

                    <dt class="col-sm-3">Modelo:</dt>
                    <dd class="col-sm-9"><span id="compra-existente-modelo">-</span></dd>

                    <dt class="col-sm-3">Série:</dt>
                    <dd class="col-sm-9"><span id="compra-existente-serie">-</span></dd>

                    <dt class="col-sm-3">Número da Nota:</dt>
                    <dd class="col-sm-9"><span id="compra-existente-numero">-</span></dd>

                    <dt class="col-sm-3">Fornecedor:</dt>
                    <dd class="col-sm-9"><span id="compra-existente-fornecedor">-</span></dd>

                    <dt class="col-sm-3">Data Emissão:</dt>
                    <dd class="col-sm-9"><span id="compra-existente-emissao">-</span></dd>

                    <dt class="col-sm-3">Data Chegada:</dt>
                    <dd class="col-sm-9"><span id="compra-existente-chegada">-</span></dd>

                    <dt class="col-sm-3">Observações:</dt>
                    <dd class="col-sm-9"><span id="compra-existente-obs">-</span></dd>

                </dl>
                <hr />
                <p class="text-muted small">Os campos do formulário foram limpos. Por favor, verifique os dados ou insira uma nova nota.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalContaAvulsaDuplicada" tabindex="-1" aria-labelledby="modalContaAvulsaDuplicadaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-warning" id="modalContaAvulsaDuplicadaLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Parcela Duplicada Encontrada
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p>Já existe uma conta a pagar registrada com esta chave (Modelo, Série, N°, Fornecedor e N° Parcela).</p>
                <p>Abaixo estão os detalhes da conta já existente:</p>

                <dl class="row">
                    <dt class="col-sm-3">Fornecedor:</dt>
                    <dd class="col-sm-9"><span id="duplicada-fornecedor">-</span></dd>

                    <dt class="col-sm-3">Nota:</dt>
                    <dd class="col-sm-9"><span id="duplicada-nota">-</span></dd>

                    <dt class="col-sm-3">Nº Parcela:</dt>
                    <dd class="col-sm-9"><span id="duplicada-parcela">-</span></dd>

                    <dt class="col-sm-3">Vencimento:</dt>
                    <dd class="col-sm-9"><span id="duplicada-vencimento">-</span></dd>

                    <dt class="col-sm-3">Valor:</dt>
                    <dd class="col-sm-9"><span id="duplicada-valor">-</span></dd>

                    <dt class="col-sm-3">Situação:</dt>
                    <dd class="col-sm-9"><span id="duplicada-situacao">-</span></dd>
                </dl>

                <hr />
                <p class="text-muted small">O campo "Número da Parcela" foi limpo. Por favor, insira um número diferente.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovoFornecedor" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovoFornecedorContent">
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaFormaPagamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalNovaFormaPagamentoContent">
        </div>
    </div>
</div>

<div class="modal fade" id="modalCidadeFornecedor" tabindex="-1" aria-labelledby="modalCidadeFornecedorLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Cidade</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="filtroCidadeFornecedor" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaCidadeFornecedor()" />

                <table class="table table-bordered table-hover" id="tabelaCidadesFornecedor">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.CidadesItens != null)
                        {
                            @foreach (var cidade in ViewBag.CidadesItens as List<SelectListItem>)
                            {
                                <tr>
                                    <td>@cidade.Text</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                onclick="selecionarCidadeFornecedor('@cidade.Value', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(cidade.Text))')">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <button class="btn btn-success" type="button" onclick="abrirFormNovaCidadeFornecedor()">
                    + Cadastrar Nova Cidade excluir
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaCidadeFornecedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalNovaCidadeContentFornecedor">
        </div>
    </div>
</div>

<div class="modal fade" id="modalCondicaoPgtoFornecedor" tabindex="-1" aria-labelledby="modalCondicaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Selecionar Condição de Pagamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="filtroCondicaoFornecedor" class="form-control mb-3" placeholder="Digite para buscar..." onkeyup="filtrarTabelaCondicaoFornecedor()" />
                <table class="table table-bordered table-hover" id="tabelaCondicoesFornecedor">
                    <thead>
                        <tr>
                            <th>Descrição</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.CondicoesPagamentoItens != null)
                        {
                            @foreach (var condicao in ViewBag.CondicoesPagamentoItens as List<SelectListItem>)
                            {
                                <tr>
                                    <td>@condicao.Text</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                onclick="selecionarCondicaoFornecedor('@condicao.Value', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(condicao.Text))')">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <button class="btn btn-success" type="button" onclick="abrirFormNovaCondicaoFornecedor()">
                    + Cadastrar Nova Condição excluir
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaCondicaoFornecedor" tabindex="-1" aria-labelledby="modalNovaCondicaoLabel">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="modalNovaCondicaoContentFornecedor">
        </div>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:\.\d{3})+)(?:,\d+)?$/.test(value);
        };

        $.validator.methods.range = function (value, element, param) {
            var globalizedValue = value.replace(".", "").replace(",", ".");
            return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
        };
    </script>


