        document.addEventListener('DOMContentLoaded', function () {

            if (modo === "Cancelar") {

                const form = document.getElementById('form-conta-pagar');
                const modalConfirmButton = document.getElementById('btn-confirmar-envio-cancelamento');
                const modalTextarea = document.getElementById('motivoCancelamentoInput');
                const hiddenInput = document.getElementById('Motivo_Cancelamento_Hidden');
                const validationMessage = document.getElementById('validation-motivo-modal');

                if (modalConfirmButton) {

                    modalConfirmButton.addEventListener('click', function() {
                        const motivo = modalTextarea.value.trim();

                        if (motivo === "") {
                            validationMessage.style.display = 'block';
                            modalTextarea.focus();
                            return;       
                        }

                        validationMessage.style.display = 'none';

                        hiddenInput.value = motivo;

                        form.submit();
                    });
                }

                if (modalTextarea) {
                    modalTextarea.addEventListener('input', function() {
                        if (validationMessage.style.display === 'block') {
                            validationMessage.style.display = 'none';
                        }
                    });
                }
            }

        });             



        document.addEventListener('DOMContentLoaded', function () {


                const form = document.getElementById('form-conta-pagar');
                if (form) {
                    form.addEventListener('keydown', function(event) {

                        if (event.key === 'Enter') {

                            if (event.target.tagName !== 'TEXTAREA') {

                                event.preventDefault();

                            }
                        }
                    });
                }

            const btnBuscarFornecedor = document.getElementById('btnBuscarFornecedorPorId');
            if (btnBuscarFornecedor) {
                btnBuscarFornecedor.addEventListener('click', buscarFornecedorPorId);
            }

            const btnBuscarFormaPgto = document.getElementById('btnBuscarFormaPgtoPorId');
            if (btnBuscarFormaPgto) {
                btnBuscarFormaPgto.addEventListener('click', buscarFormaPgtoPorId);
            }


            });       
        const modo = "@modo";

        

        function parseValor(valorString) {
            if (!valorString) return 0;

            let valorNumerico = String(valorString)
                .replace(',', '.');

            return parseFloat(valorNumerico) || 0;
        }

        function formatarMoeda(valor) {
            const n = parseFloat(valor) || 0;
            return n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function calcularValorPago() {
            const valorParcelaInput = document.getElementById('ValorParcela');
            const valorBase = parseValor(valorParcelaInput.value);

            const jurosInput = document.getElementById('Juros');
            const multaInput = document.getElementById('Multa');
            const descontoInput = document.getElementById('Desconto');

            const jurosPercentAoDia = parseValor(jurosInput.value);
            const multaPercent = parseValor(multaInput.value);
            const descontoPercent = parseValor(descontoInput.value);

            const dataPagamentoInput = document.getElementById('DataPagamento');
            const dataVencimentoInput = document.getElementById('DataVencimento');
            let total = valorBase;

            if (dataPagamentoInput.value && dataVencimentoInput.value) {

                const dataPag = new Date(dataPagamentoInput.value + 'T00:00:00');
                const dataVenc = new Date(dataVencimentoInput.value + 'T00:00:00');

                if (dataPag > dataVenc) {
                    total += (valorBase * (multaPercent / 100));

                    const diffTime = dataPag - dataVenc;             
                    const diasDeAtraso = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                    const valorJurosPorDia = (valorBase * (jurosPercentAoDia / 100));

                    const totalJuros = valorJurosPorDia * diasDeAtraso;

                    total += totalJuros;
                } else {
                    total -= (valorBase * (descontoPercent / 100));
                }
            }

            const valorPagoDisplayInput = document.getElementById('ValorPagoDisplay');
            const valorPagoHiddenInput = document.getElementById('ValorPagoHidden');

            if (valorPagoDisplayInput && valorPagoHiddenInput) {
                valorPagoDisplayInput.value = formatarMoeda(total);

                valorPagoHiddenInput.value = total.toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                useGrouping: false
                });   
            }
        }


        document.addEventListener('DOMContentLoaded', function () {

            function getTodayString() {
                const hoje = new Date();
                const ano = hoje.getFullYear();
                const mes = String(hoje.getMonth() + 1).padStart(2, '0');
                const dia = String(hoje.getDate()).padStart(2, '0');
                return `${ano}-${mes}-${dia}`;
            }

            const todayString = getTodayString();

            const dataEmissaoInput = document.getElementById('DataEmissao');
            const dataVencimentoInput = document.getElementById('DataVencimento');

            if (modo === "Criar" && dataEmissaoInput && dataVencimentoInput) {

                dataEmissaoInput.max = todayString;

                dataVencimentoInput.min = dataEmissaoInput.value;

                dataEmissaoInput.addEventListener('input', function() {
                    const emissaoValue = dataEmissaoInput.value;
                    dataVencimentoInput.min = emissaoValue;
                    if (dataVencimentoInput.value < emissaoValue) {
                        dataVencimentoInput.value = '';
                    }
                });

                dataEmissaoInput.addEventListener('blur', function() {
                    if (dataEmissaoInput.value > todayString) {
                        alert('A Data de Emissão não pode ser futura. Ajustando para hoje.');
                        dataEmissaoInput.value = todayString;
                        dataEmissaoInput.dispatchEvent(new Event('input'));
                    }
                });

                dataVencimentoInput.addEventListener('blur', function() {
                    const emissaoValue = dataEmissaoInput.value;
                    const vencimentoValue = dataVencimentoInput.value;

                    if (vencimentoValue && emissaoValue && vencimentoValue < emissaoValue) {
                        alert('A Data de Vencimento não pode ser anterior à Data de Emissão. Ajustando para hoje.');
                        dataVencimentoInput.value = todayString;
                    }
                });
            }

           if (modo === "Baixar") {
            const dataPagamentoInput = document.getElementById('DataPagamento');
            const jurosInput = document.getElementById('Juros');
            const multaInput = document.getElementById('Multa');
            const descontoInput = document.getElementById('Desconto');

            if (dataPagamentoInput) {
                dataPagamentoInput.max = todayString;

                if (!dataPagamentoInput.value) {
                    dataPagamentoInput.value = todayString;
                }

                dataPagamentoInput.addEventListener('blur', function() {
                    const dataPagValue = dataPagamentoInput.value;
                    const dataEmissaoValue = dataEmissaoInput.value;

                    if (dataPagValue && dataEmissaoValue && dataPagValue < dataEmissaoValue) {
                        alert('A Data de Pagamento não pode ser anterior à Data de Emissão. Ajustando para hoje.');
                        dataPagamentoInput.value = todayString;
                        dataPagamentoInput.dispatchEvent(new Event('input'));
                    }

                    if (dataPagValue > todayString) {
                         alert('A Data de Pagamento não pode ser futura. Ajustando para hoje.');
                         dataPagamentoInput.value = todayString;
                         dataPagamentoInput.dispatchEvent(new Event('input'));
                    }
                });
            }

            if (dataPagamentoInput) dataPagamentoInput.addEventListener('input', calcularValorPago);
            if (jurosInput)        jurosInput.addEventListener('input', calcularValorPago);
            if (multaInput)        multaInput.addEventListener('input', calcularValorPago);
            if (descontoInput)     descontoInput.addEventListener('input', calcularValorPago);

            calcularValorPago();
        }


            if (modo === "Detalhes") {
            const valorPagoHiddenInput = document.getElementById('ValorPagoHidden');
            const valorPagoDisplayInput = document.getElementById('ValorPagoDisplay');

            if (valorPagoHiddenInput && valorPagoDisplayInput) {
                const valorNumerico = parseValor(valorPagoHiddenInput.value);

                if (valorNumerico > 0) {
                    valorPagoDisplayInput.value = formatarMoeda(valorNumerico);
                }
            }
        }
        });

    </script>
}