        function calcularValoresIniciais() {
            if (modo !== "Baixar" && modo !== "Detalhes") return;

            const valorParcelaInput = document.getElementById('ValorParcela');
            const valorBase = parseValor(valorParcelaInput.value);

            const jurosPercent = parseValor(document.getElementById('JurosPercentual').value);
            const multaPercent = parseValor(document.getElementById('MultaPercentual').value);
            const descontoPercent = parseValor(document.getElementById('DescontoPercentual').value);

            const dataPagamentoInput = document.getElementById('DataPagamento');
            const dataVencimentoInput = document.getElementById('DataVencimento');

            let valJuros = 0;
            let valMulta = 0;
            let valDesconto = 0;

            if (dataPagamentoInput.value && dataVencimentoInput.value) {
                const dataPag = new Date(dataPagamentoInput.value + 'T00:00:00');
                const dataVenc = new Date(dataVencimentoInput.value + 'T00:00:00');

                if (dataPag > dataVenc) {
                    valMulta = valorBase * (multaPercent / 100);

                    const diffTime = dataPag - dataVenc;
                    const diasDeAtraso = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    const valorJurosPorDia = (valorBase * (jurosPercent / 100));     
                    valJuros = valorJurosPorDia * diasDeAtraso;

                    valDesconto = 0;

                } else {
                    valDesconto = valorBase * (descontoPercent / 100);

                    valJuros = 0;
                    valMulta = 0;
                }
            }

            document.getElementById('ValJuros').value = valJuros.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('ValMulta').value = valMulta.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('ValDesconto').value = valDesconto.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

           if (modo === "Baixar") {
            somarTotalFinal();
            }
        }

        function somarTotalFinal() {
            const valorParcelaInput = document.getElementById('ValorParcela');
            const valorBase = parseValor(valorParcelaInput.value);

            const vJuros = parseValor(document.getElementById('ValJuros').value);
            const vMulta = parseValor(document.getElementById('ValMulta').value);
            const vDesconto = parseValor(document.getElementById('ValDesconto').value);

            let total = valorBase + vJuros + vMulta - vDesconto;

            if (total < 0) total = 0;

            const valorPagoDisplayInput = document.getElementById('ValorPagoDisplay');
            const valorPagoHiddenInput = document.getElementById('ValorPagoHidden');

            if (valorPagoDisplayInput && valorPagoHiddenInput) {
                valorPagoDisplayInput.value = formatarMoeda(total);
                valorPagoHiddenInput.value = total.toLocaleString('pt-BR', { minimumFractionDigits: 2, useGrouping: false });
            }
        }


     

        document.addEventListener('DOMContentLoaded', function () {
            if (modo === "Baixar" || modo === "Detalhes") {
                const dataPagamentoInput = document.getElementById('DataPagamento');

                if (modo === "Baixar" && dataPagamentoInput && !dataPagamentoInput.value) {
                    const todayString = new Date().toISOString().split('T')[0];
                    dataPagamentoInput.value = todayString;
                }

                if (dataPagamentoInput) {
                    dataPagamentoInput.addEventListener('change', calcularValoresIniciais);
                    dataPagamentoInput.addEventListener('blur', function() {
                         calcularValoresIniciais();
                    });
                }

                document.getElementById('ValJuros').addEventListener('input', somarTotalFinal);
                document.getElementById('ValMulta').addEventListener('input', somarTotalFinal);
                document.getElementById('ValDesconto').addEventListener('input', somarTotalFinal);

                if (modo === "Baixar") {
                calcularValoresIniciais();
                }
            }
        });

        async function verificarDuplicidadeContaAvulsa() {
            const modeloInput = document.getElementById('Modelo');
            const serieInput = document.getElementById('Serie');
            const numeroNotaInput = document.getElementById('NumeroNota');
            const fornecedorIdInput = document.getElementById('FornecedorId');       
            const numeroParcelaInput = document.getElementById('NumeroParcela');

            const modelo = modeloInput?.value?.trim() || '';
            const serie = serieInput?.value?.trim() || '';
            const numeroNota = parseInt(numeroNotaInput?.value || '0');
            const fornecedorId = parseInt(fornecedorIdInput?.value || '0');
            const numeroParcela = parseInt(numeroParcelaInput?.value || '0');

            if (modo === "Criar" && fornecedorId > 0 && numeroParcela > 0) {

                console.log('Verificando duplicidade de parcela:', { modelo, serie, numeroNota, fornecedorId, numeroParcela });

                try {
                    const url = `@Url.Action("VerificarContaDuplicada", "ContaAPagar")?modelo=${encodeURIComponent(modelo)}&serie=${encodeURIComponent(serie)}&numeroNota=${numeroNota}&fornecedorId=${fornecedorId}&numeroParcela=${numeroParcela}`;
                    const response = await fetch(url);

                    if (!response.ok) {
                        console.error('Erro na resposta do servidor:', response.statusText);
                        return;
                    }

                    const resultado = await response.json();

                    if (resultado.existe) {
                        const conta = resultado.conta;

                        document.getElementById('duplicada-fornecedor').textContent = `${conta.fornecedorId} - ${conta.nomeFornecedor || 'N/A'}`;
                        document.getElementById('duplicada-nota').textContent = `${conta.modelo || 'N/D'} / ${conta.serie || 'N/D'} - ${conta.numeroNota || 'N/A'}`;
                        document.getElementById('duplicada-parcela').textContent = conta.numeroParcela;
                        document.getElementById('duplicada-vencimento').textContent = formatarDataString(conta.dataVencimento);
                        document.getElementById('duplicada-valor').textContent = formatarMoeda(conta.valorParcela);
                        document.getElementById('duplicada-situacao').textContent = `${conta.situacao} (${conta.status ? 'Ativo' : 'Cancelado'})`;

                        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalContaAvulsaDuplicada'));
                        modal.show();

                        numeroParcelaInput.value = '';       
                        numeroParcelaInput.focus();
                    }

                } catch (error)
                {
                    console.error('Erro ao verificar duplicidade de parcela:', error);
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (modo === "Criar") {
                const numeroParcelaInput = document.getElementById('NumeroParcela');
                if(numeroParcelaInput) {
                    numeroParcelaInput.addEventListener('blur', verificarDuplicidadeContaAvulsa);
                }
            }
        });

         function formatarDataString(dataString) {
             if (!dataString || !dataString.includes('-')) return '-';
             try {
                 const [ano, mes, dia] = dataString.split('-');
                 if (dia && mes && ano && dia.length === 2 && mes.length === 2 && ano.length === 4) {
                     return `${dia}/${mes}/${ano}`;
                 }
                 return 'Data Inválida';
             } catch(e) {
                 console.error("Erro ao formatar data string:", e, dataString);
                 return 'Erro Formato';
             }
         }

         async function verificarChaveDuplicada() {
             const modeloInput = document.getElementById('Modelo');
             const serieInput = document.getElementById('Serie');
             const numeroNotaInput = document.getElementById('NumeroNota');
             const fornecedorIdInput = document.getElementById('FornecedorId');       

             const modelo = modeloInput?.value?.trim() || '';
             const serie = serieInput?.value?.trim() || '';
             const numeroNota = numeroNotaInput?.value?.trim() || '';
             const fornecedorId = parseInt(fornecedorIdInput?.value || '0');

             if (modo === "Criar" && modelo && serie && numeroNota && fornecedorId > 0) {

                 try {
                     const url = `@Url.Action("VerificarChaveExistente", "Compra")?modelo=${encodeURIComponent(modelo)}&serie=${encodeURIComponent(serie)}&numeroNota=${encodeURIComponent(numeroNota)}&fornecedorId=${fornecedorId}`;
                     const response = await fetch(url);

                     if (!response.ok) {
                         console.error('Erro na resposta do servidor ao verificar chave:', response.statusText);
                         return;
                     }

                     const resultado = await response.json();

                     if (resultado.existe) {
                         const compraDetalhes = resultado.compra;

                         document.getElementById('compra-existente-modelo').textContent = compraDetalhes.modelo || '-';
                         document.getElementById('compra-existente-serie').textContent = compraDetalhes.serie || '-';
                         document.getElementById('compra-existente-numero').textContent = compraDetalhes.numeroNota || '-';
                         document.getElementById('compra-existente-fornecedor').textContent = `${compraDetalhes.fornecedorId} - ${compraDetalhes.nomeFornecedor || 'N/A'}`;
                         document.getElementById('compra-existente-emissao').textContent = formatarDataString(compraDetalhes.dataEmissao);
                         document.getElementById('compra-existente-chegada').textContent = formatarDataString(compraDetalhes.dataChegada);
                         document.getElementById('compra-existente-obs').textContent = compraDetalhes.observacoes || '(Nenhuma)';

                         const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCompraExistente'));
                         modal.show();

                         if (modeloInput) modeloInput.value = '';
                         if (serieInput) serieInput.value = '';
                         if (numeroNotaInput) numeroNotaInput.value = '';
                         if (fornecedorIdInput) fornecedorIdInput.value = '';

                         document.getElementById('FornecedorIdInput').value = '';
                         document.getElementById('NomeFornecedor').value = 'Nenhum fornecedor selecionado';
                         modeloInput?.focus();
                     }

                 } catch (error) {
                     console.error('Erro ao verificar chave duplicada:', error);
                 }
             }
         }

         document.addEventListener('DOMContentLoaded', function () {
            if (modo === "Criar") {
                const modeloInput = document.getElementById('Modelo');
                const serieInput = document.getElementById('Serie');
                const numeroNotaInput = document.getElementById('NumeroNota');

                if(modeloInput) modeloInput.addEventListener('blur', verificarChaveDuplicada);
                if(serieInput) serieInput.addEventListener('blur', verificarChaveDuplicada);
                if(numeroNotaInput) numeroNotaInput.addEventListener('blur', verificarChaveDuplicada);
            }
        });



