@model List<Pagamento.Models.ContaAPagar>

@{
    ViewData["Title"] = "Contas a Pagar";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="CriarAvulsa" class="btn btn-primary">Nova Conta </a>
</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}


<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Origem (Nº Nota)</th>
                    <th>Fornecedor</th>
                    <th>Vencimento</th>
                    <th>Valor da Parcela</th>
                    <th>Nº Parcela</th>
                    <th>Situação</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string trClass = "";

                    if (!item.Status)
                    {
                        trClass = "table-secondary text-decoration-line-through";
                    }
                    else
                    {
                        bool vencidaEmAberto = item.Situacao == "A PAGAR"
                                               && item.DataVencimento.Date < DateTime.Today;

                        DateTime? dataPagamento = item.DataPagamento;                      
                        bool pagaAtrasada = item.Situacao == "PAGO"
                                            && dataPagamento.HasValue
                                            && dataPagamento.Value.Date > item.DataVencimento.Date;

                        if (item.Situacao == "PAGO")
                        {
                            trClass = pagaAtrasada ? "table-danger" : "table-success";
                        }
                        else if (vencidaEmAberto)
                        {
                            trClass = "table-danger";
                        }
                    }

                    <tr class="@trClass">
                        <td>
                            @if (!string.IsNullOrEmpty(item.Modelo))
                            {
                                <small>@($"{item.Modelo}/{item.Serie} - {item.NumeroNota}")</small>
                            }
                            else
                            {
                                <small>Avulsa</small>
                            }
                        </td>

                        <td>@item.NomeFornecedor</td>
                        <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>

                        <td title="@(item.ValorPago.HasValue ? "Valor pago" : "Valor da parcela")">
                            @{
                                decimal valor = item.ValorPago.GetValueOrDefault(item.ValorParcela);
                            }
                            @valor.ToString("C2")
                        </td>

                        <td>@item.NumeroParcela</td>

                        <td>
                            <span class="badge
                                @(item.Situacao == "PAGO" ? "bg-success" :
                                  (item.Situacao == "A PAGAR" ? "bg-warning text-dark" : "bg-secondary"))">
                                @item.Situacao
                            </span>
                        </td>

                        

                        <td>
                            <span class="badge @(item.Status ? "bg-success" : "bg-danger")">
                                @(item.Status ? "Ativo" : "Cancelado")
                            </span>
                        </td>
                        <td>
                            @{
                                string baixarDisabled = (item.Situacao != "A PAGAR" || item.Status == false) ? "disabled" : "";
                                string cancelarDisabled = (item.Situacao == "PAGO" || item.Status == false) ? "disabled" : "";
                            }
                            <a asp-action="Detalhes"
                               asp-route-modelo="@item.Modelo"
                               asp-route-serie="@item.Serie"
                               asp-route-numeroNota="@item.NumeroNota"
                               asp-route-fornecedorId="@item.FornecedorId"
                               asp-route-numeroParcela="@item.NumeroParcela"
                               class="btn btn-sm btn-info"
                               title="Ver Detalhes">
                                Detalhes
                            </a>
                            @*   
                                            
                                             
                                                                                                                                                                                             *@
                            <button type="button"
                                    class="btn btn-sm btn-primary btn-verificar-baixa @baixarDisabled"
                                    title="Pagar/Baixar"
                                    data-modelo="@item.Modelo"
                                    data-serie="@item.Serie"
                                    data-numero-nota="@item.NumeroNota"
                                    data-fornecedor-id="@item.FornecedorId"
                                    data-numero-parcela="@item.NumeroParcela"
                                    data-url-baixar="@Url.Action("Baixar", new { 
                                        modelo = item.Modelo, 
                                        serie = item.Serie, 
                                        numeroNota = item.NumeroNota, 
                                        fornecedorId = item.FornecedorId, 
                                        numeroParcela = item.NumeroParcela 
                                    })">
                                Baixar
                            </button>

                            @*   
                                       
                               
                                       
                            *@
                            <a asp-action="Cancelar"
                               asp-route-modelo="@item.Modelo"
                               asp-route-serie="@item.Serie"
                               asp-route-numeroNota="@item.NumeroNota"
                               asp-route-fornecedorId="@item.FornecedorId"
                               asp-route-numeroParcela="@item.NumeroParcela"
                               class="btn btn-sm btn-danger @cancelarDisabled"
                               title="Cancelar Conta">
                                Cancelar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalAvisoPendencia" tabindex="-1" aria-labelledby="modalAvisoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-warning" id="modalAvisoLabel">Aviso de Pendência</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p id="modalAvisoPendenciaBody">Mensagem de erro.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalAvisoErro" tabindex="-1" aria-labelledby="modalAvisoErroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalAvisoErroLabel">Atenção</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @TempData["ErrorMessage"]
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>

        $(document).ready(function () {
                      
            var mensagemErro = '@TempData["ErrorMessage"]';

                            
            if (mensagemErro && mensagemErro.trim() !== "") {
                var myModal = new bootstrap.Modal(document.getElementById('modalAvisoErro'));
                myModal.show();
            }
        });


        document.addEventListener('DOMContentLoaded', function () {
            const modalElement = document.getElementById('modalAvisoPendencia');
            const modalAviso = new bootstrap.Modal(modalElement);
            const modalBody = document.getElementById('modalAvisoPendenciaBody');
            document.querySelectorAll('.btn-verificar-baixa').forEach(button => {
                
                button.addEventListener('click', async function () {
                    
                                  
                    const dataset = this.dataset;
                    const modelo = dataset.modelo || '';
                    const serie = dataset.serie || '';
                    const numeroNota = dataset.numeroNota || 0;
                    const fornecedorId = dataset.fornecedorId || 0;
                    const numeroParcela = dataset.numeroParcela || 0;
                    
                    if (modelo === '') {
                        window.location.href = dataset.urlBaixar;
                        return;
                    }

                                
                    const urlVerificar = `@Url.Action("VerificarPendenciaParcela", "ContaAPagar")?modelo=${encodeURIComponent(modelo)}&serie=${encodeURIComponent(serie)}&numeroNota=${numeroNota}&fornecedorId=${fornecedorId}&numeroParcela=${numeroParcela}`;

                    try {
                                  
                        const response = await fetch(urlVerificar);
                        if (!response.ok) {
                            throw new Error('Erro ao conectar com o servidor.');
                        }
                        
                        const data = await response.json();

                        if (data.temPendencia) {
                                            
                            modalBody.textContent = data.mensagem;
                            modalAviso.show();
                        } else {
                                                
                            window.location.href = dataset.urlBaixar;
                        }

                    } catch (error) {
                                    
                        modalBody.textContent = 'Erro ao verificar parcela: ' + error.message;
                        modalAviso.show();
                    }
                });
            });
        });
    </script>
}